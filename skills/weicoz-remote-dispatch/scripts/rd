#!/usr/bin/env python3
"""rd — dispatch coding-agent sessions and test commands to remote machines over SSH.

The local machine only needs python3 (3.8+), git and ssh. A worker only needs a
POSIX shell, git, and whichever agent CLIs you want to run there.

Config:  $RD_CONFIG or ~/.config/remote-dispatch/config.ini
State:   $RD_STATE  or ~/.local/state/remote-dispatch
"""
import argparse
import concurrent.futures
import configparser
import json
import os
import re
import shlex
import subprocess
import sys
import time

CONFIG = os.environ.get("RD_CONFIG") or os.path.expanduser("~/.config/remote-dispatch/config.ini")
STATE = os.environ.get("RD_STATE") or os.path.expanduser("~/.local/state/remote-dispatch")
HERE = os.path.dirname(os.path.abspath(__file__))

DEFAULTS = {
    "workdir": "~/remote-dispatch",
    "sync": "origin",
    "launcher": "nohup",
    "path": "$HOME/.local/bin:$HOME/.kimi-code/bin:/opt/homebrew/bin:/usr/local/bin",
    "ssh_opts": "-o BatchMode=yes -o ConnectTimeout=8",
    "env_file": "",
    "tags": "",
    "enabled": "true",
    "max_heavy": "1",
    "max_load_per_core": "1.5",
    "min_free_mem_pct": "10",
    "min_free_disk_gb": "10",
    "timeout": "3600",
}

SESSION_RE = r'"(?:session_id|sessionId|thread_id)":\s*"([^"]+)"'

# Templates run on the worker inside the job's worktree. Available variables:
# $RD_WT (worktree), $RD_JOB_DIR (logs), $RD_PROMPT (prompt file), $RD_ROUND.
# {model_args} and {session} are filled in by rd.
AGENTS = {
    "codex": {
        "start": 'codex exec -C "$RD_WT" -s danger-full-access -c approval_policy=never --json {model_args} '
        '-o "$RD_JOB_DIR/last.r$RD_ROUND.txt" - < "$RD_PROMPT"',
        "resume": "codex exec resume {session} -c sandbox_mode='\"danger-full-access\"' "
        '-c approval_policy=never --json {model_args} -o "$RD_JOB_DIR/last.r$RD_ROUND.txt" - < "$RD_PROMPT"',
        "model": "-m {model}",
        "effort": "-c model_reasoning_effort={effort}",
    },
    "kimi": {
        "start": 'kimi --auto {model_args} --output-format stream-json -p "$(cat "$RD_PROMPT")"',
        "resume": 'kimi --auto -S {session} {model_args} --output-format stream-json -p "$(cat "$RD_PROMPT")"',
        "model": "-m {model}",
    },
    "dsh": {
        "start": 'dsh headless --json - < "$RD_PROMPT"',
        "resume": 'dsh headless --json --session-id {session} - < "$RD_PROMPT"',
    },
    "claude": {
        "start": "claude -p --output-format stream-json --verbose --dangerously-skip-permissions "
        '{model_args} < "$RD_PROMPT"',
        "resume": "claude -p --resume {session} --output-format stream-json --verbose "
        '--dangerously-skip-permissions {model_args} < "$RD_PROMPT"',
        "model": "--model {model}",
    },
}

KILLTREE = 'killtree() { for c in $(pgrep -P "$1" 2>/dev/null); do killtree "$c"; done; kill "$1" 2>/dev/null; }'

RUN_TEMPLATE = r"""#!/bin/sh
# generated by rd — job @@JOB@@, round @@ROUND@@
export PATH="@@PATH@@:$PATH"
ROOT=@@ROOT@@
export RD_JOB=@@JOB@@ RD_ROUND=@@ROUND@@
export RD_JOB_DIR="$ROOT/jobs/$RD_JOB" RD_WT="$ROOT/wt/$RD_JOB"
export RD_LOCK_DIR="$ROOT/locks" RD_MAX_HEAVY=@@MAX_HEAVY@@
export RD_PROMPT="$RD_JOB_DIR/prompt.r$RD_ROUND.md"
export PATH="$ROOT/bin:$PATH"
@@ENV_FILE@@
@@KILLTREE@@
rm -f "$RD_JOB_DIR/exit_code" "$RD_JOB_DIR/timed_out"
echo $$ > "$RD_JOB_DIR/pid"
cd "$RD_WT" || { echo 96 > "$RD_JOB_DIR/exit_code"; exit 96; }
date -u +%Y-%m-%dT%H:%M:%SZ > "$RD_JOB_DIR/started.r$RD_ROUND"
if [ -f "$RD_JOB_DIR/setup.sh" ] && [ ! -f "$RD_JOB_DIR/setup.done" ]; then
  if sh "$RD_JOB_DIR/setup.sh" > "$RD_JOB_DIR/setup.log" 2>&1; then
    touch "$RD_JOB_DIR/setup.done"
  else
    echo 97 > "$RD_JOB_DIR/exit_code"; exit 97
  fi
fi
sh "$RD_JOB_DIR/cmd.r$RD_ROUND.sh" > "$RD_JOB_DIR/stdout.r$RD_ROUND.log" 2> "$RD_JOB_DIR/stderr.r$RD_ROUND.log" &
cpid=$!
( sleep @@TIMEOUT@@; : > "$RD_JOB_DIR/timed_out"; killtree $cpid ) &
wpid=$!
wait $cpid; rc=$?
killtree $wpid
[ -f "$RD_JOB_DIR/timed_out" ] && rc=124
git rev-parse HEAD > "$RD_JOB_DIR/head" 2>/dev/null
git status --porcelain 2>/dev/null | wc -l | tr -d ' ' > "$RD_JOB_DIR/dirty"
@@PUSH@@
echo $rc > "$RD_JOB_DIR/exit_code"
"""

PROBE = r"""
os=$(uname -s)
if [ "$os" = Darwin ]; then
  ncpu=$(sysctl -n hw.ncpu); load1=$(sysctl -n vm.loadavg | awk '{print $2}')
  memfree=$(memory_pressure 2>/dev/null | awk -F': ' '/free percentage/ {gsub("%","",$2); print $2}')
  swap=$(sysctl -n vm.swapusage | awk '{print $6}')
else
  ncpu=$(nproc 2>/dev/null); load1=$(cut -d' ' -f1 /proc/loadavg 2>/dev/null)
  memfree=$(awk '/MemTotal/{t=$2}/MemAvailable/{a=$2}END{if(t)printf "%d",a*100/t}' /proc/meminfo 2>/dev/null)
  swap=$(awk '/SwapTotal/{t=$2}/SwapFree/{f=$2}END{printf "%dM",(t-f)/1024}' /proc/meminfo 2>/dev/null)
fi
d="$ROOT"; [ -d "$d" ] || d="$HOME"
disk=$(df -Pk "$d" | awk 'NR==2{printf "%d",$4/1048576}')
running=0
for j in "$ROOT"/jobs/*/; do
  [ -f "$j/pid" ] && [ ! -f "$j/exit_code" ] && kill -0 "$(cat "$j/pid")" 2>/dev/null && running=$((running+1))
done
heavy=0
for s in "$ROOT"/locks/heavy.*/; do
  [ -f "$s/pid" ] && kill -0 "$(cat "$s/pid")" 2>/dev/null && heavy=$((heavy+1))
done
echo "os=$os ncpu=$ncpu load1=$load1 memfree=$memfree swap=$swap disk=$disk running=$running heavy=$heavy"
"""


def die(msg, code=1):
    print(f"rd: {msg}", file=sys.stderr)
    sys.exit(code)


def run(cmd, check=True, capture=True, **kw):
    p = subprocess.run(cmd, text=True, stdout=subprocess.PIPE if capture else None,
                       stderr=subprocess.PIPE if capture else None, **kw)
    if check and p.returncode != 0:
        die(f"command failed ({p.returncode}): {' '.join(map(str, cmd))}\n{(p.stderr or '').strip()}")
    return p


# ---------------------------------------------------------------- config

class Config:
    def __init__(self):
        self.cp = configparser.ConfigParser(interpolation=None)
        self.cp.read(CONFIG)

    def _section(self, kind, name):
        key = f"{kind}:{name}"
        return dict(self.cp[key]) if self.cp.has_section(key) else None

    def host(self, name):
        sec = self._section("host", name)
        if sec is None:
            die(f"no [host:{name}] in {CONFIG}")
        h = dict(DEFAULTS)
        if self.cp.has_section("defaults"):
            h.update(self.cp["defaults"])
        h.update(sec)
        if not h.get("ssh"):
            die(f"[host:{name}] needs ssh = user@address")
        h["name"] = name
        return h

    def hosts(self):
        names = [s.split(":", 1)[1] for s in self.cp.sections() if s.startswith("host:")]
        return [h for h in map(self.host, names) if h["enabled"].lower() in ("1", "true", "yes")]

    def project(self, name):
        return self._section("project", name) or {}

    def agent(self, name):
        a = dict(AGENTS.get(name, {}))
        a.update(self._section("agent", name) or {})
        if "start" not in a:
            die(f"unknown agent '{name}'. Built in: {', '.join(AGENTS)}; add [agent:{name}] to {CONFIG}")
        a.setdefault("session_regex", SESSION_RE)
        a.setdefault("bin", a["start"].split()[0])
        return a


def root_expr(host):
    """Shell expression for the worker's root directory."""
    w = host["workdir"].rstrip("/")
    if w == "~":
        return '"$HOME"'
    if w.startswith("~/"):
        return '"$HOME/' + w[2:] + '"'
    return shlex.quote(w)


def scp_path(host, rel):
    """scp-style path (relative to the home directory when workdir starts with ~)."""
    w = host["workdir"].rstrip("/")
    base = w[2:] if w.startswith("~/") else ("" if w == "~" else w)
    return f"{host['ssh']}:{base + '/' if base else ''}{rel}"


def ssh(host, script, check=True, stdin_data=None, stdin=None, timeout=None):
    pre = f'export PATH="{host["path"]}:$PATH"; ROOT={root_expr(host)}; '
    cmd = ["ssh", *shlex.split(host["ssh_opts"]), host["ssh"], "sh -c " + shlex.quote(pre + script)]
    try:
        if stdin is None and stdin_data is None:
            stdin = subprocess.DEVNULL
        p = subprocess.run(cmd, text=stdin_data is not None, input=stdin_data, stdin=stdin,
                           stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout)
    except subprocess.TimeoutExpired:
        if check:
            die(f"ssh to {host['name']} timed out")
        return None
    out = p.stdout if isinstance(p.stdout, str) else p.stdout.decode(errors="replace")
    err = p.stderr if isinstance(p.stderr, str) else p.stderr.decode(errors="replace")
    if check and p.returncode != 0:
        die(f"[{host['name']}] remote step failed ({p.returncode}):\n{(err or out).strip()}")
    return subprocess.CompletedProcess(cmd, p.returncode, out, err)


# ---------------------------------------------------------------- probing

def probe(host):
    r = ssh(host, PROBE, check=False, timeout=25)
    info = {"host": host["name"], "reachable": bool(r and r.returncode == 0)}
    if info["reachable"]:
        info.update(kv.split("=", 1) for kv in r.stdout.split() if "=" in kv)
    else:
        info["error"] = ((r.stderr if r else "timeout") or "").strip().splitlines()[-1:] or ["unreachable"]
        info["error"] = info["error"][0]
    return info


def num(v):
    try:
        return float(v)
    except (TypeError, ValueError):
        return None


def assess(host, info):
    """Return a list of reasons this host should not take a new session."""
    if not info["reachable"]:
        return [f"unreachable: {info['error']}"]
    why = []
    load, ncpu = num(info.get("load1")), num(info.get("ncpu"))
    if load is not None and ncpu and load / ncpu > float(host["max_load_per_core"]):
        why.append(f"load {load:.1f} on {int(ncpu)} cores")
    mem = num(info.get("memfree"))
    if mem is not None and mem < float(host["min_free_mem_pct"]):
        why.append(f"only {mem:.0f}% memory free")
    disk = num(info.get("disk"))
    if disk is not None and disk < float(host["min_free_disk_gb"]):
        why.append(f"only {disk:.0f} GB disk free")
    return why


def probe_all(hosts):
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as ex:
        return list(zip(hosts, ex.map(probe, hosts)))


def fmt_probe(host, info, why):
    if not info["reachable"]:
        return f"{host['name']:<12} UNREACHABLE  {info['error']}"
    unk = lambda k, suf="": (info.get(k) or "?") + suf
    verdict = "ok" if not why else "busy: " + "; ".join(why)
    return (f"{host['name']:<12} load {unk('load1')}/{unk('ncpu')}c  mem-free {unk('memfree', '%')}  "
            f"swap {unk('swap')}  disk {unk('disk', 'G')}  sessions {unk('running')}  "
            f"heavy {unk('heavy')}/{host['max_heavy']}  -> {verdict}")


def pick_host(cfg, name, tags):
    if name and name != "auto":
        host = cfg.host(name)
        info = probe(host)
        why = assess(host, info)
        print(fmt_probe(host, info, why))
        if why:
            die(f"{name} cannot take the job now ({'; '.join(why)}). Wait, or pass --force-host.", 3)
        return host
    hosts = [h for h in cfg.hosts() if set(tags) <= {t.strip() for t in h["tags"].split(",") if t.strip()}]
    if not hosts:
        die(f"no enabled host{' with tags ' + ','.join(tags) if tags else ''} in {CONFIG}")
    free = []
    for host, info in probe_all(hosts):
        why = assess(host, info)
        print(fmt_probe(host, info, why))
        if not why:
            # 没有会话数上限：能不能接由负载、内存、磁盘决定；多台都能接时挑负载最低的。
            per_core = (num(info.get("load1")) or 0) / (num(info.get("ncpu")) or 1)
            free.append((per_core, int(num(info.get("running")) or 0), host["name"], host))
    if not free:
        die("no host can take the job right now; nothing was dispatched.", 3)
    return sorted(free, key=lambda t: t[:3])[0][3]


# ---------------------------------------------------------------- local git

def git(args, repo, check=True, env=None):
    return run(["git", "-C", repo, *args], check=check, env=env)


def local_repo():
    p = run(["git", "rev-parse", "--show-toplevel"], check=False)
    if p.returncode != 0:
        die("run this inside the git repository you want to dispatch from")
    return p.stdout.strip()


def project_name(repo):
    url = git(["remote", "get-url", "origin"], repo, check=False).stdout.strip()
    base = url.rstrip("/").rsplit("/", 1)[-1] if url else os.path.basename(repo)
    name = re.sub(r"\.git$", "", base)
    return re.sub(r"[^A-Za-z0-9._-]", "-", name), url


def git_ssh_env(host):
    return dict(os.environ, GIT_SSH_COMMAND="ssh " + host["ssh_opts"])


# ---------------------------------------------------------------- job records

def job_path(job):
    return os.path.join(STATE, "jobs", job + ".json")


def save_job(rec):
    os.makedirs(os.path.dirname(job_path(rec["job"])), exist_ok=True)
    with open(job_path(rec["job"]), "w") as f:
        json.dump(rec, f, indent=2, ensure_ascii=False)


def load_job(job):
    try:
        with open(job_path(job)) as f:
            return json.load(f)
    except FileNotFoundError:
        die(f"unknown job '{job}'. See: rd status")


def all_jobs():
    d = os.path.join(STATE, "jobs")
    names = sorted(f[:-5] for f in os.listdir(d) if f.endswith(".json")) if os.path.isdir(d) else []
    return [load_job(n) for n in names]


# ---------------------------------------------------------------- run / resume

def build_run_script(host, rec, round_no, timeout):
    push = ""
    if rec["sync"] == "origin":
        push = (f'git push origin "HEAD:refs/heads/{rec["branch"]}" > "$RD_JOB_DIR/push.log" 2>&1; '
                'echo $? > "$RD_JOB_DIR/push_rc"')
    env_file = ""
    if host["env_file"]:
        ef = host["env_file"].replace("~/", "$HOME/", 1)
        env_file = f'[ -f "{ef}" ] && . "{ef}"'
    subs = {"JOB": rec["job"], "ROUND": str(round_no), "PATH": host["path"], "ROOT": root_expr(host),
            "MAX_HEAVY": host["max_heavy"], "ENV_FILE": env_file, "KILLTREE": KILLTREE,
            "TIMEOUT": str(int(timeout)), "PUSH": push}
    text = RUN_TEMPLATE
    for k, v in subs.items():
        text = text.replace(f"@@{k}@@", v)
    return text


def agent_command(agent, model, effort, session=None):
    args = []
    if model:
        if "model" not in agent:
            die("this agent has no model flag; set the model in its own config on the worker")
        args.append(agent["model"].replace("{model}", shlex.quote(model)))
    if effort:
        if "effort" not in agent:
            die("this agent has no reasoning-effort flag")
        args.append(agent["effort"].replace("{effort}", shlex.quote(effort)))
    tpl = agent["resume"] if session else agent["start"]
    return tpl.replace("{model_args}", " ".join(args)).replace("{session}", shlex.quote(session or ""))


def put_file(host, rel, content, mode="644"):
    ssh(host, f'mkdir -p "$(dirname "$ROOT/{rel}")" && cat > "$ROOT/{rel}" && chmod {mode} "$ROOT/{rel}"',
        stdin_data=content)


def launch(host, rec, round_no, cmd_text, prompt_text, timeout):
    j = rec["job"]
    put_file(host, f"jobs/{j}/cmd.r{round_no}.sh", cmd_text + "\n")
    if prompt_text is not None:
        put_file(host, f"jobs/{j}/prompt.r{round_no}.md", prompt_text)
    put_file(host, f"jobs/{j}/run.r{round_no}.sh", build_run_script(host, rec, round_no, timeout), "755")
    with open(os.path.join(HERE, "rd-heavy")) as f:
        put_file(host, "bin/rd-heavy", f.read(), "755")
    script = f'"$ROOT/jobs/{j}/run.r{round_no}.sh"'
    if host["launcher"] == "tmux":
        start = f"tmux new-session -d -s {shlex.quote('rd-' + j + '-r' + str(round_no))} sh {script}"
    elif host["launcher"] == "nohup":
        start = f"nohup sh {script} > /dev/null 2>&1 < /dev/null &"
    else:
        die(f"[host:{host['name']}] launcher must be nohup or tmux")
    ssh(host, f'rm -f "$ROOT/jobs/{j}/exit_code" "$ROOT/jobs/{j}/pid"; {start}')


def cmd_run(a, cfg):
    repo = local_repo()
    project, origin_url = project_name(repo)
    proj = cfg.project(a.project or project)
    project = a.project or project
    if a.test:
        a.cmd = proj.get("test") or die(f"--test needs 'test = <command>' under [project:{project}] in {CONFIG}")
        a.heavy = a.heavy or proj.get("test_heavy", "true").lower() in ("1", "true", "yes")
    if bool(a.agent) == bool(a.cmd):
        die("give exactly one of --agent (with --prompt-file) or --cmd / --test")
    prompt = None
    if a.agent:
        if not a.prompt_file:
            die("--agent needs --prompt-file")
        prompt = sys.stdin.read() if a.prompt_file == "-" else open(a.prompt_file).read()
        agent = cfg.agent(a.agent)

    ref = a.ref
    if a.wip:
        wip = git(["stash", "create"], repo).stdout.strip()
        ref = wip or ref
        print("wip: sending tracked uncommitted changes" if wip else "wip: working tree is clean, sending " + a.ref)
    sha = git(["rev-parse", "--verify", ref + "^{commit}"], repo).stdout.strip()
    dirty = git(["status", "--porcelain"], repo).stdout.strip()
    if dirty and not a.wip:
        print("note: uncommitted local changes are NOT sent (commit them, or use --wip / --include).")

    stamp = time.strftime("%m%d-%H%M%S")
    name = re.sub(r"[^A-Za-z0-9._-]+", "-", a.name or a.agent or "cmd").strip("-")
    job = f"{project}-{name}-{stamp}"
    branch = a.branch or f"rd/{name}-{stamp}"

    host = cfg.host(a.host) if a.force_host and a.host not in (None, "auto") else pick_host(cfg, a.host, a.tag)
    rec = {"job": job, "host": host["name"], "project": project, "repo": repo, "branch": branch,
           "base": sha, "sync": host["sync"], "agent": a.agent, "cmd": a.cmd, "rounds": 1,
           "created": time.strftime("%Y-%m-%d %H:%M:%S")}
    print(f"dispatching {job} -> {host['name']} (branch {branch}, base {sha[:10]}, sync {host['sync']})")

    bare = f"repos/{project}.git"
    if host["sync"] == "origin":
        worker_url = proj.get("origin_url") or origin_url or die("this repository has no 'origin' remote")
        git(["push", "origin", f"{sha}:refs/heads/{branch}"], repo)
        prep = (f'[ -d "$ROOT/{bare}" ] || GIT_TERMINAL_PROMPT=0 git clone --bare {shlex.quote(worker_url)} '
                f'"$ROOT/{bare}" || exit 90\n'
                f'GIT_TERMINAL_PROMPT=0 git -C "$ROOT/{bare}" fetch origin '
                f'"+refs/heads/{branch}:refs/heads/{branch}" || exit 91\n')
    elif host["sync"] == "direct":
        ssh(host, f'mkdir -p "$ROOT/repos" && {{ [ -d "$ROOT/{bare}" ] || git init -q --bare "$ROOT/{bare}"; }}')
        git(["push", scp_path(host, bare), f"{sha}:refs/heads/{branch}"], repo, env=git_ssh_env(host))
        prep = ""
    else:
        die(f"[host:{host['name']}] sync must be origin or direct")
    ssh(host, f'mkdir -p "$ROOT/jobs/{job}" "$ROOT/wt" "$ROOT/locks" "$ROOT/bin"\n{prep}'
              f'git -C "$ROOT/{bare}" worktree add -q "$ROOT/wt/{job}" {shlex.quote(branch)} || exit 92')

    if a.include:
        tar = subprocess.Popen(["tar", "-cf", "-", "-C", repo, *a.include], stdout=subprocess.PIPE,
                               env=dict(os.environ, COPYFILE_DISABLE="1"))
        ssh(host, f'tar -xf - -C "$ROOT/wt/{job}"', stdin=tar.stdout)
        if tar.wait() != 0:
            die("could not pack --include paths")
    if proj.get("setup"):
        put_file(host, f"jobs/{job}/setup.sh", proj["setup"] + "\n")

    if a.agent:
        cmd_text = agent_command(agent, a.model, a.effort)
    else:
        cmd_text = ("rd-heavy sh -c " + shlex.quote(a.cmd)) if a.heavy else a.cmd
    save_job(rec)
    launch(host, rec, 1, cmd_text, prompt, a.timeout or host["timeout"])
    print(f"started. job id: {job}")
    print(f"  rd status {job}    rd logs {job}    rd wait {job}    rd fetch {job}")


def remote_state(host, jobs):
    script = "for J in " + " ".join(map(shlex.quote, jobs)) + r'''; do
  D="$ROOT/jobs/$J"; st=missing
  if [ -d "$D" ]; then
    st=starting
    if [ -f "$D/exit_code" ]; then st=done
    elif [ -f "$D/pid" ] && kill -0 "$(cat "$D/pid")" 2>/dev/null; then st=running
    elif [ -f "$D/pid" ]; then st=dead; fi
  fi
  n=$(ls "$D"/run.r*.sh 2>/dev/null | wc -l | tr -d ' ')
  last=$(tail -n 5 "$D/stdout.r$n.log" 2>/dev/null | awk 'NF{l=$0}END{print l}' | tr '\t' ' ' | cut -c1-200)
  setup=; [ -f "$D/setup.sh" ] && { [ -f "$D/setup.done" ] && setup=done || setup=pending; }
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$J" "$st" "$(cat "$D/exit_code" 2>/dev/null)" \
    "$([ -f "$D/timed_out" ] && echo yes)" "$(cat "$D/push_rc" 2>/dev/null)" "$(cat "$D/head" 2>/dev/null)" \
    "$(cat "$D/dirty" 2>/dev/null)" "$n" "$setup" "$last"
done'''
    r = ssh(host, script, check=False, timeout=30)
    out = {}
    if not r or r.returncode != 0:
        return {j: {"state": "unreachable"} for j in jobs}
    keys = ["job", "state", "exit", "timed_out", "push_rc", "head", "dirty", "round", "setup", "last"]
    for line in r.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) == len(keys):
            out[parts[0]] = dict(zip(keys, parts))
    return out


def job_states(cfg, recs):
    by_host = {}
    for r in recs:
        by_host.setdefault(r["host"], []).append(r["job"])
    states = {}
    for h, jobs in by_host.items():
        states.update(remote_state(cfg.host(h), jobs))
    return states


def describe(rec, st):
    s = st.get("state", "?")
    bits = [f"{rec['job']}  [{rec['host']}]  {s}"]
    if s == "done":
        code = st.get("exit")
        label = {"0": "ok", "124": "timed out", "97": "setup failed", "96": "worktree missing", "143": "stopped"}.get(code, "failed")
        bits.append(f"exit {code} ({label})")
    if st.get("setup") == "pending" and s == "running":
        bits.append("running setup")
    if st.get("head"):
        bits.append("no new commits" if st["head"] == rec["base"] else f"new commits (head {st['head'][:10]})")
    if st.get("dirty") not in (None, "", "0"):
        bits.append(f"{st['dirty']} uncommitted file(s) left in worktree")
    if rec["sync"] == "origin" and st.get("push_rc") not in (None, "", "0"):
        bits.append("PUSH FAILED (see: rd logs JOB --file push.log)")
    line = "  ".join(bits)
    if s == "running" and st.get("last"):
        line += f"\n    last output: {st['last']}"
    return line


def cmd_status(a, cfg):
    recs = [load_job(a.job)] if a.job else all_jobs()
    if not recs:
        print("no jobs.")
        return
    states = job_states(cfg, recs)
    if a.json:
        print(json.dumps([dict(r, **states.get(r["job"], {})) for r in recs], indent=2, ensure_ascii=False))
        return
    for r in recs:
        print(describe(r, states.get(r["job"], {})))


def cmd_wait(a, cfg):
    rec = load_job(a.job)
    deadline = time.time() + a.timeout if a.timeout else None
    while True:
        st = job_states(cfg, [rec]).get(rec["job"], {})
        if st.get("state") in ("done", "dead", "missing"):
            print(describe(rec, st))
            sys.exit(0 if st.get("exit") == "0" else 1)
        if deadline and time.time() > deadline:
            print(describe(rec, st))
            sys.exit(2)
        time.sleep(a.interval)


def cmd_logs(a, cfg):
    rec = load_job(a.job)
    host = cfg.host(rec["host"])
    rnd = a.round or rec["rounds"]
    name = a.file or {"out": f"stdout.r{rnd}.log", "err": f"stderr.r{rnd}.log", "setup": "setup.log",
                      "last": f"last.r{rnd}.txt"}[a.stream]
    if not re.fullmatch(r"[A-Za-z0-9._-]+", name):
        die("bad file name")
    r = ssh(host, f'tail -n {int(a.lines)} "$ROOT/jobs/{rec["job"]}/{name}"', check=False)
    sys.stdout.write(r.stdout if r.returncode == 0 else f"(no {name} yet)\n")


def find_session(host, rec, agent):
    r = ssh(host, f'head -c 200000 "$ROOT/jobs/{rec["job"]}"/stdout.r*.log 2>/dev/null', check=False)
    m = re.search(agent["session_regex"], r.stdout or "")
    return m.group(1) if m else None


def cmd_resume(a, cfg):
    rec = load_job(a.job)
    if not rec.get("agent"):
        die("only agent jobs can be resumed; start a new job for commands")
    host = cfg.host(rec["host"])
    st = remote_state(host, [rec["job"]]).get(rec["job"], {})
    if st.get("state") in ("running", "starting"):
        die("the job is still running; rd stop it first or wait")
    if st.get("state") in ("missing", "unreachable"):
        die(f"job is {st.get('state')} on {host['name']}")
    info = probe(host)
    why = assess(host, info)
    print(fmt_probe(host, info, why))
    if why and not a.force_host:
        die(f"{host['name']} cannot take the session now ({'; '.join(why)}).", 3)
    agent = cfg.agent(rec["agent"])
    session = a.session or find_session(host, rec, agent)
    if not session:
        die("could not find the agent's session id in the logs; pass --session ID")
    prompt = sys.stdin.read() if a.prompt_file == "-" else open(a.prompt_file).read()
    rec["rounds"] += 1
    save_job(rec)
    launch(host, rec, rec["rounds"], agent_command(agent, a.model, a.effort, session), prompt,
           a.timeout or host["timeout"])
    print(f"resumed {rec['job']} (round {rec['rounds']}, session {session})")


def cmd_fetch(a, cfg):
    rec = load_job(a.job)
    host = cfg.host(rec["host"])
    repo, b = rec["repo"], rec["branch"]
    spec = f"+refs/heads/{b}:refs/remotes/rd/{b}"
    if rec["sync"] == "origin":
        git(["fetch", "origin", spec], repo)
    else:
        git(["fetch", scp_path(host, f"repos/{rec['project']}.git"), spec], repo, env=git_ssh_env(host))
    log = git(["log", "--oneline", f"{rec['base']}..rd/{b}"], repo).stdout.strip()
    print(f"fetched into rd/{b}")
    print(log if log else "(no commits on top of the dispatched base)")
    if log:
        print(f"review: git diff {rec['base'][:10]}..rd/{b}     take it: git merge --ff-only rd/{b}")


def cmd_stop(a, cfg):
    rec = load_job(a.job)
    host = cfg.host(rec["host"])
    r = ssh(host, KILLTREE + f'; D="$ROOT/jobs/{rec["job"]}"; p=$(cat "$D/pid" 2>/dev/null); '
            'if [ -n "$p" ] && kill -0 "$p" 2>/dev/null; then killtree "$p"; echo 143 > "$D/exit_code"; '
            'echo stopped; else echo "not running"; fi')
    print(r.stdout.strip())


def cmd_clean(a, cfg):
    rec = load_job(a.job)
    host = cfg.host(rec["host"])
    j, b = rec["job"], rec["branch"]
    st = remote_state(host, [j]).get(j, {})
    if st.get("state") in ("running", "starting"):
        die("the job is still running; rd stop it first")
    if st.get("state") == "unreachable":
        die(f"{host['name']} is unreachable; nothing was removed")
    if st.get("state") != "missing" and not a.force:
        r = ssh(host, f'git -C "$ROOT/wt/{j}" status --porcelain 2>/dev/null | wc -l; '
                      f'git -C "$ROOT/wt/{j}" rev-parse HEAD 2>/dev/null', check=False)
        lines = r.stdout.split()
        dirty, head = (lines + ["0", ""])[:2]
        if dirty.strip() != "0":
            die(f"{dirty.strip()} uncommitted file(s) in the remote worktree would be lost. Check them, or --force.")
        have = git(["rev-parse", "-q", "--verify", f"refs/remotes/rd/{b}"], rec["repo"], check=False).stdout.strip()
        if head and head != rec["base"] and head != have:
            die("the job has commits you have not fetched. Run rd fetch first, or --force.")
    bare = f"repos/{rec['project']}.git"
    drop = f'git -C "$ROOT/{bare}" branch -q -D {shlex.quote(b)} 2>/dev/null; ' if a.delete_branch else ""
    ssh(host, f'git -C "$ROOT/{bare}" worktree remove --force "$ROOT/wt/{j}" 2>/dev/null; '
              f'git -C "$ROOT/{bare}" worktree prune; {drop}rm -rf "$ROOT/jobs/{j}"')
    if a.delete_branch and rec["sync"] == "origin":
        git(["push", "origin", "--delete", b], rec["repo"], check=False)
    os.remove(job_path(j))
    print(f"cleaned {j}" + (" and deleted branch " + b if a.delete_branch else f" (branch {b} kept)"))


def cmd_hosts(a, cfg):
    hosts = cfg.hosts()
    if not hosts:
        die(f"no hosts configured. Add a [host:NAME] section to {CONFIG}")
    for host, info in probe_all(hosts):
        print(fmt_probe(host, info, assess(host, info)))


def cmd_doctor(a, cfg):
    host = cfg.host(a.host)
    agents = a.agent or list(AGENTS)
    checks = ['ok() { echo "  ok    $1"; }; bad() { echo "  MISSING  $1"; fail=1; }; fail=0',
              'command -v git >/dev/null && ok "git $(git --version | cut -d" " -f3)" || bad git',
              'command -v pgrep >/dev/null && ok pgrep || bad "pgrep (needed for timeouts and rd stop)"']
    if host["launcher"] == "tmux":
        checks.append('command -v tmux >/dev/null && ok tmux || bad "tmux (launcher = tmux)"')
    for name in agents:
        b = cfg.agent(name)["bin"]
        opt = "" if a.agent else " (only needed if you dispatch to it)"
        checks.append(f'command -v {shlex.quote(b)} >/dev/null && ok "agent {name}: $(command -v {shlex.quote(b)})" '
                      f'|| echo "  absent   agent {name}{opt}"')
    url = None
    if host["sync"] == "origin":
        p = run(["git", "rev-parse", "--show-toplevel"], check=False)
        if p.returncode == 0:
            project, origin_url = project_name(p.stdout.strip())
            url = cfg.project(project).get("origin_url") or origin_url
        if url:
            checks.append(f'GIT_TERMINAL_PROMPT=0 git ls-remote {shlex.quote(url)} HEAD >/dev/null 2>&1 '
                          f'&& ok "can read {url}" || bad "git access to {url} (worker needs its own credentials '
                          f'with push rights, or use sync = direct)"')
        else:
            checks.append('echo "  skipped  origin access (run rd doctor inside the repository to test it)"')
    checks.append("exit $fail")
    print(f"{host['name']} ({host['ssh']}), sync = {host['sync']}, launcher = {host['launcher']}")
    r = ssh(host, "\n".join(checks), check=False, timeout=60)
    if r is None:
        die("timed out")
    sys.stdout.write(r.stdout or r.stderr)
    info = probe(host)
    print(fmt_probe(host, info, assess(host, info)))
    sys.exit(r.returncode)


def main():
    ap = argparse.ArgumentParser(prog="rd", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="command", required=True)

    sub.add_parser("hosts", help="probe every configured machine").set_defaults(fn=cmd_hosts)

    p = sub.add_parser("doctor", help="check that a machine has what a job needs")
    p.add_argument("host")
    p.add_argument("--agent", action="append", help="require this agent (repeatable)")
    p.set_defaults(fn=cmd_doctor)

    p = sub.add_parser("run", help="dispatch an agent session or a command")
    p.add_argument("--agent", help=f"agent to run ({', '.join(AGENTS)}, or one from the config)")
    p.add_argument("--prompt-file", help="prompt for the agent ('-' reads stdin)")
    p.add_argument("--cmd", help="shell command to run instead of an agent")
    p.add_argument("--test", action="store_true", help="run the project's configured test command")
    p.add_argument("--heavy", action="store_true", help="hold a heavy slot while the command runs")
    p.add_argument("--host", default="auto", help="machine name, or auto (default)")
    p.add_argument("--force-host", action="store_true", help="skip the load check for --host")
    p.add_argument("--tag", action="append", default=[], help="only machines with this tag (repeatable)")
    p.add_argument("--ref", default="HEAD", help="commit to send (default HEAD)")
    p.add_argument("--wip", action="store_true", help="also send tracked uncommitted changes")
    p.add_argument("--branch", help="branch the job works on (default rd/<name>-<time>)")
    p.add_argument("--name", help="short label used in the job id")
    p.add_argument("--project", help="project name (default: name of the origin repository)")
    p.add_argument("--include", action="append", default=[], help="extra untracked path to copy (repeatable)")
    p.add_argument("--model")
    p.add_argument("--effort")
    p.add_argument("--timeout", type=int, help="seconds before the job is killed")
    p.set_defaults(fn=cmd_run)

    p = sub.add_parser("status", help="show jobs")
    p.add_argument("job", nargs="?")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_status)

    p = sub.add_parser("wait", help="block until a job finishes (exit 0 ok, 1 failed, 2 still running)")
    p.add_argument("job")
    p.add_argument("--timeout", type=int)
    p.add_argument("--interval", type=int, default=30)
    p.set_defaults(fn=cmd_wait)

    p = sub.add_parser("logs", help="show the tail of a job's output")
    p.add_argument("job")
    p.add_argument("stream", nargs="?", default="out", choices=["out", "err", "setup", "last"])
    p.add_argument("-n", "--lines", default=40)
    p.add_argument("--round", type=int)
    p.add_argument("--file", help="any file in the job directory, e.g. push.log")
    p.set_defaults(fn=cmd_logs)

    p = sub.add_parser("resume", help="continue an agent job in the same session")
    p.add_argument("job")
    p.add_argument("--prompt-file", required=True)
    p.add_argument("--session", help="session id, if it cannot be found in the logs")
    p.add_argument("--model")
    p.add_argument("--effort")
    p.add_argument("--timeout", type=int)
    p.add_argument("--force-host", action="store_true")
    p.set_defaults(fn=cmd_resume)

    p = sub.add_parser("fetch", help="bring the job's commits back as rd/<branch>")
    p.add_argument("job")
    p.set_defaults(fn=cmd_fetch)

    p = sub.add_parser("stop", help="kill a running job")
    p.add_argument("job")
    p.set_defaults(fn=cmd_stop)

    p = sub.add_parser("clean", help="remove a finished job's worktree and logs from the worker")
    p.add_argument("job")
    p.add_argument("--delete-branch", action="store_true", help="also delete the job branch (worker and origin)")
    p.add_argument("--force", action="store_true", help="discard uncommitted or unfetched work")
    p.set_defaults(fn=cmd_clean)

    a = ap.parse_args()
    a.fn(a, Config())


if __name__ == "__main__":
    main()
