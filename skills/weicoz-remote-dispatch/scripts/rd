#!/usr/bin/env python3
"""rd — dispatch coding-agent sessions and test commands to remote machines over SSH.

Command dispatch needs local Python 3.8+, git and ssh. Employee Codex profiles
need Python 3.11+ on both machines, plus git and Codex on the worker.

Config:  $RD_CONFIG or ~/.config/remote-dispatch/config.ini
State:   $RD_STATE  or ~/.local/state/remote-dispatch
"""
import argparse
import concurrent.futures
import configparser
import hashlib
import json
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys
import tempfile
import time
import rd_profiles as profiles
import rd_native as native
import rd_messages as messages

CONFIG = os.environ.get("RD_CONFIG") or os.path.expanduser("~/.config/remote-dispatch/config.ini")
STATE = os.environ.get("RD_STATE") or os.path.expanduser("~/.local/state/remote-dispatch")
HERE = os.path.dirname(os.path.abspath(__file__))

DEFAULTS = {
    "workdir": "~/remote-dispatch",
    "sync": "origin",
    "launcher": "nohup",
    "path": "$HOME/.local/bin:$HOME/.kimi-code/bin:/opt/homebrew/bin:/usr/local/bin",
    "ssh_opts": "-o BatchMode=yes -o ConnectTimeout=8",
    "env_file": "",
    "codex_auth_file": "",
    "platform": "posix",
    "python": "python",
    "max_cpu_pct": "85",
    "tags": "",
    "enabled": "true",
    "max_heavy": "1",
    "max_load_per_core": "1.5",
    "min_free_mem_pct": "10",
    "min_free_disk_gb": "10",
    "timeout": "3600",
}

SESSION_RE = r'"(?:session_id|sessionId|thread_id)":\s*"([^"]+)"'

# Templates run on the worker inside the job's worktree. Available variables:
# $RD_WT (worktree), $RD_JOB_DIR (logs), $RD_PROMPT (prompt file), $RD_ROUND.
# {model_args} and {session} are filled in by rd.
AGENTS = {
    "codex": {
        "start": 'codex exec -C "$RD_WT" --json {model_args} '
        '-o "$RD_JOB_DIR/last.r$RD_ROUND.txt" - < "$RD_PROMPT"',
        "resume": 'codex exec resume {session} --json {model_args} -o "$RD_JOB_DIR/last.r$RD_ROUND.txt" - < "$RD_PROMPT"',
        "model": "-m {model}",
        "effort": "-c model_reasoning_effort={effort}",
    },
    "kimi": {
        "start": 'kimi --auto {model_args} --output-format stream-json -p "$(cat "$RD_PROMPT")"',
        "resume": 'kimi --auto -S {session} {model_args} --output-format stream-json -p "$(cat "$RD_PROMPT")"',
        "model": "-m {model}",
    },
    "dsh": {
        "start": 'dsh headless --json - < "$RD_PROMPT"',
        "resume": 'dsh headless --json --session-id {session} - < "$RD_PROMPT"',
    },
    "claude": {
        "start": "claude -p --output-format stream-json --verbose --dangerously-skip-permissions "
        '{model_args} < "$RD_PROMPT"',
        "resume": "claude -p --resume {session} --output-format stream-json --verbose "
        '--dangerously-skip-permissions {model_args} < "$RD_PROMPT"',
        "model": "--model {model}",
    },
}

KILLTREE = 'killtree() { for c in $(pgrep -P "$1" 2>/dev/null); do killtree "$c"; done; kill "$1" 2>/dev/null; }'

CODEX_CHECK = r'''python3 -c "import tomllib" || exit 1
codex sandbox --help | grep -q -- --permission-profile || exit 1
flags=$(codex features list) || exit 1
for flag in hooks plugins memories external_agent_memory_import; do
  echo "$flags" | awk '{print $1}' | grep -qx "$flag" || exit 1
done
'''

RUN_TEMPLATE = r"""#!/bin/sh
# generated by rd — job @@JOB@@, round @@ROUND@@
export PATH="@@PATH@@:$PATH"
ROOT=@@ROOT@@
export RD_JOB=@@JOB@@ RD_ROUND=@@ROUND@@
export RD_JOB_DIR="$ROOT/jobs/$RD_JOB" RD_WT="$ROOT/wt/$RD_JOB"
export RD_LOCK_DIR=@@SHARED_ROOT@@/locks RD_MAX_HEAVY=@@MAX_HEAVY@@
export RD_PROMPT="$RD_JOB_DIR/prompt.r$RD_ROUND.md"
@@REPORT_ENV@@
export PATH="$ROOT/bin:$PATH"
@@ENV_FILE@@
@@IDENTITY@@
@@KILLTREE@@
rm -f "$RD_JOB_DIR/exit_code" "$RD_JOB_DIR/timed_out"
echo $$ > "$RD_JOB_DIR/pid"
cd "$RD_WT" || { echo 96 > "$RD_JOB_DIR/exit_code"; exit 96; }
date -u +%Y-%m-%dT%H:%M:%SZ > "$RD_JOB_DIR/started.r$RD_ROUND"
if [ -f "$RD_JOB_DIR/setup.sh" ] && [ ! -f "$RD_JOB_DIR/setup.done" ]; then
  if sh "$RD_JOB_DIR/setup.sh" > "$RD_JOB_DIR/setup.log" 2>&1; then
    touch "$RD_JOB_DIR/setup.done"
  else
    rc=97; @@REPORT_FINISH@@
    echo 97 > "$RD_JOB_DIR/exit_code"; exit 97
  fi
fi
@@EXEC@@ > "$RD_JOB_DIR/stdout.r$RD_ROUND.log" 2> "$RD_JOB_DIR/stderr.r$RD_ROUND.log" &
cpid=$!
( sleep @@TIMEOUT@@; : > "$RD_JOB_DIR/timed_out"; killtree $cpid ) &
wpid=$!
wait $cpid; rc=$?
killtree $wpid
[ -f "$RD_JOB_DIR/timed_out" ] && rc=124
git rev-parse HEAD > "$RD_JOB_DIR/head" 2>/dev/null
git status --porcelain 2>/dev/null | wc -l | tr -d ' ' > "$RD_JOB_DIR/dirty"
@@PUSH@@
@@REPORT_FINISH@@
echo $rc > "$RD_JOB_DIR/exit_code"
"""

PROBE = r"""
os=$(uname -s)
if [ "$os" = Darwin ]; then
  ncpu=$(sysctl -n hw.ncpu); load1=$(sysctl -n vm.loadavg | awk '{print $2}')
  memfree=$(memory_pressure 2>/dev/null | awk -F': ' '/free percentage/ {gsub("%","",$2); print $2}')
  swap=$(sysctl -n vm.swapusage | awk '{print $6}')
else
  ncpu=$(nproc 2>/dev/null); load1=$(cut -d' ' -f1 /proc/loadavg 2>/dev/null)
  memfree=$(awk '/MemTotal/{t=$2}/MemAvailable/{a=$2}END{if(t)printf "%d",a*100/t}' /proc/meminfo 2>/dev/null)
  swap=$(awk '/SwapTotal/{t=$2}/SwapFree/{f=$2}END{printf "%dM",(t-f)/1024}' /proc/meminfo 2>/dev/null)
fi
d="$ROOT"; [ -d "$d" ] || d="$HOME"
disk=$(df -Pk "$d" | awk 'NR==2{printf "%d",$4/1048576}')
running=0
for j in "$SHARED_ROOT"/jobs/*/ "$SHARED_ROOT"/users/*/jobs/*/; do
  [ -f "$j/pid" ] && [ ! -f "$j/exit_code" ] && kill -0 "$(cat "$j/pid")" 2>/dev/null && running=$((running+1))
done
heavy=0
for s in "$SHARED_ROOT"/locks/heavy.*/; do
  [ -f "$s/pid" ] && kill -0 "$(cat "$s/pid")" 2>/dev/null && heavy=$((heavy+1))
done
echo "os=$os ncpu=$ncpu load1=$load1 memfree=$memfree swap=$swap disk=$disk running=$running heavy=$heavy"
"""


def die(msg, code=1):
    print(f"rd: {msg}", file=sys.stderr)
    sys.exit(code)


def run(cmd, check=True, capture=True, **kw):
    p = subprocess.run(cmd, text=True, stdout=subprocess.PIPE if capture else None,
                       stderr=subprocess.PIPE if capture else None, **kw)
    if check and p.returncode != 0:
        die(f"command failed ({p.returncode}): {' '.join(map(str, cmd))}\n{(p.stderr or '').strip()}")
    return p


# ---------------------------------------------------------------- config

class Config:
    def __init__(self):
        self.cp = configparser.ConfigParser(interpolation=None)
        self.cp.read(CONFIG, encoding="utf-8")

    def _section(self, kind, name):
        key = f"{kind}:{name}"
        return dict(self.cp[key]) if self.cp.has_section(key) else None

    def report_interval(self):
        value = os.environ.get("RD_REPORT_INTERVAL_SECONDS") or self.cp.get("monitor", "report_interval_seconds", fallback="900")
        try:
            interval = int(value)
        except (ValueError, TypeError):
            die("RD_REPORT_INTERVAL_SECONDS / [monitor] report_interval_seconds must be a positive integer (seconds)", 4)
        if interval <= 0:
            die("RD_REPORT_INTERVAL_SECONDS / [monitor] report_interval_seconds must be a positive integer (seconds)", 4)
        return interval

    def host(self, name):
        sec = self._section("host", name)
        if sec is None:
            die(f"no [host:{name}] in {CONFIG}")
        h = dict(DEFAULTS)
        if self.cp.has_section("defaults"):
            h.update(self.cp["defaults"])
        h.update(sec)
        if h["platform"] in ("macos", "linux"):
            h["platform"] = "posix"
        if h["platform"] not in ("posix", "windows"):
            die("platform 必须是 macos、linux、posix 或 windows。")
        if h["platform"] == "windows":
            h["path"] = sec.get("path", "")
        if not h.get("ssh"):
            die(f"[host:{name}] needs ssh = user@address")
        h["name"] = name
        return h

    def hosts(self):
        names = [s.split(":", 1)[1] for s in self.cp.sections() if s.startswith("host:")]
        return [h for h in map(self.host, names) if h["enabled"].lower() in ("1", "true", "yes")]

    def project(self, name):
        return self._section("project", name) or {}

    def agent(self, name):
        a = dict(AGENTS.get(name, {}))
        a.update(self._section("agent", name) or {})
        if "start" not in a:
            die(f"unknown agent '{name}'. Built in: {', '.join(AGENTS)}; add [agent:{name}] to {CONFIG}")
        a.setdefault("session_regex", SESSION_RE)
        a.setdefault("bin", a["start"].split()[0])
        a["kind"] = name
        return a


def root_expr(host):
    """Shell expression for the worker's root directory."""
    w = host["workdir"].rstrip("/")
    if w == "~":
        return '"$HOME"'
    if w.startswith("~/"):
        return '"$HOME/' + w[2:] + '"'
    return shlex.quote(w)


def scp_path(host, rel):
    """scp-style path (relative to the home directory when workdir starts with ~)."""
    w = host["workdir"].rstrip("/")
    base = w[2:] if w.startswith("~/") else ("" if w == "~" else w)
    return f"{host['ssh']}:{base + '/' if base else ''}{rel}"


def ssh(host, script, check=True, stdin_data=None, stdin=None, timeout=None):
    shared = dict(host, workdir=host.get("shared_workdir", host["workdir"]))
    pre = f'export PATH="{host["path"]}:$PATH"; ROOT={root_expr(host)}; SHARED_ROOT={root_expr(shared)}; '
    cmd = ["ssh", *shlex.split(host["ssh_opts"]), host["ssh"], "sh -c " + shlex.quote(pre + script)]
    try:
        if stdin is None and stdin_data is None:
            stdin = subprocess.DEVNULL
        p = subprocess.run(cmd, text=stdin_data is not None, input=stdin_data, stdin=stdin,
                           stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout)
    except subprocess.TimeoutExpired:
        if check:
            die(f"ssh to {host['name']} timed out")
        return None
    out = p.stdout if isinstance(p.stdout, str) else p.stdout.decode(errors="replace")
    err = p.stderr if isinstance(p.stderr, str) else p.stderr.decode(errors="replace")
    if check and p.returncode != 0:
        die(f"[{host['name']}] remote step failed ({p.returncode}):\n{(err or out).strip()}")
    return subprocess.CompletedProcess(cmd, p.returncode, out, err)


def require_user():
    try:
        return profiles.user_id()
    except ValueError as error:
        die(str(error), 4)


def scoped_host(host, uid):
    return dict(host, shared_workdir=host["workdir"], workdir=host["workdir"].rstrip("/") + "/users/" + uid)


def job_host(cfg, rec):
    host = cfg.host(rec["host"])
    if rec.get("user_id"):
        if require_user() != rec["user_id"]:
            die("当前 RD_USER_ID 与任务员工 ID 不匹配。", 4)
        host = scoped_host(host, rec["user_id"])
        host["workdir"] = rec.get("worker_root", host["workdir"])
        host["shared_workdir"] = rec.get("shared_root", host["shared_workdir"])
        host["platform"] = rec.get("worker_platform", host["platform"])
        host["python"] = rec.get("worker_python", host["python"])
    return host


def local_profile(uid, required=False):
    source = os.environ.get("RD_PROFILE_DIR") or os.path.expanduser("~/.config/remote-dispatch/profiles/" + uid)
    if not os.path.isdir(source) and not required:
        return None, None
    return profiles.bundle(source, uid, STATE)


def remote_profile(host, uid):
    if host["platform"] == "windows":
        value = native.request(host, "profile-read")
        host["resolved_workdir"] = value["root"]
        return profiles.validate_manifest(value["manifest"], uid) if value["manifest"] else None
    r = ssh(host, '[ ! -f "$ROOT/profiles/current.json" ] || cat "$ROOT/profiles/current.json"')
    if not r.stdout.strip():
        return None
    try:
        return profiles.validate_manifest(json.loads(r.stdout), uid)
    except (ValueError, TypeError):
        die("远端员工配置元数据无效；先检查 ID、时间和配置清单。", 4)


def profile_report(host, uid, local, remote):
    state = profiles.comparison(local, remote)
    fmt = lambda p: time.strftime("%Y-%m-%d %H:%M:%S UTC", time.gmtime(p["source_updated_at"])) if p else "未确认"
    print(f"Remote Dispatch: ID={uid} host={host['name']} root={host.get('resolved_workdir', host['workdir'])}")
    print(f"配置源更新时间：本地 {fmt(local)}；远端 {fmt(remote)}；状态 {state}")
    if local:
        print("本地配置版本：" + local["fingerprint"])
        old = remote.get("files", {}) if remote else {}
        changed = [n for n, v in local["files"].items() if old.get(n) != v]
        removed = sorted(set(old) - set(local["files"]))
        print("同步清单：" + ", ".join(local["files"]))
        print("变化：" + (", ".join(changed) or "无") + "；移出新版本：" + (", ".join(removed) or "无"))
    if state == "stale":
        print("提醒：本地配置领先远端超过 7 天。是否更新？未确认时使用现有远端版本；同步需单独确认。")
    elif state == "remote-newer":
        print("提醒：远端配置更新；不得自动用另一台电脑的旧配置覆盖。")
    elif state == "unknown":
        print("未确认：此电脑未准备本地配置包，无法比较更新时间；使用已有远端版本。")
    elif state == "missing":
        print("远端首次使用此 ID。必须询问员工 ID 和是否同步，确认后执行 rd profile sync。")
    return state


def cmd_profile(a, cfg):
    uid = require_user()
    host = scoped_host(cfg.host(a.host), uid)
    local, payload = local_profile(uid, required=a.action == "sync")
    remote = remote_profile(host, uid)
    profile_report(host, uid, local, remote)
    if a.action == "check":
        return
    if a.confirm_user_id != uid or not a.confirm_version or a.confirm_version != local["fingerprint"]:
        die("尚未确认同步：向用户展示 ID、清单和版本，明确同意后传 --confirm-user-id 和 --confirm-version。", 4)
    if remote and remote["fingerprint"] == local["fingerprint"]:
        print("配置内容一致；无需更新。")
        return
    if remote and local["source_updated_at"] < remote["source_updated_at"]:
        die("本地配置比远端旧；先取正确配置，不覆盖远端新版本。", 4)
    version = local["fingerprint"]
    expected_current = remote["fingerprint"] if remote else ""
    if host["platform"] == "windows":
        synced = native.request(host, "profile-sync", {"expected": remote, "manifest": local, "user_id": uid}, payload=payload)
        if synced["fingerprint"] != version:
            die("Windows 配置同步回读版本不匹配。")
        print(f"已同步：ID={uid} version={version}；旧版本保留。")
        return
    with tempfile.TemporaryFile() as stream:
        stream.write(payload)
        stream.seek(0)
        ssh(host, f'''set -e
umask 077
mkdir -p "$ROOT/profiles"
mkdir "$ROOT/profiles/.sync-lock" || {{ echo "另一次同步进行中" >&2; exit 4; }}
trap 'rmdir "$ROOT/profiles/.sync-lock"' EXIT
current=$([ ! -f "$ROOT/profiles/current.json" ] || python3 -c 'import json,sys; print(json.load(sys.stdin)["fingerprint"])' < "$ROOT/profiles/current.json")
[ "$current" = {shlex.quote(expected_current)} ] || {{ echo "远端配置已变化，请重新检查并确认" >&2; exit 4; }}
stage=$(mktemp -d "$ROOT/profiles/.incoming.XXXXXX")
trap 'rm -rf "$stage"; rmdir "$ROOT/profiles/.sync-lock"' EXIT
tar -xf - -C "$stage"
cp "$stage/manifest.json" "$ROOT/profiles/current.tmp"
if [ ! -d "$ROOT/profiles/{version}" ]; then mv "$stage" "$ROOT/profiles/{version}"; fi
mv "$ROOT/profiles/current.tmp" "$ROOT/profiles/current.json"
''', stdin=stream)
    synced = remote_profile(host, uid)
    if synced["fingerprint"] != version:
        die("同步回读版本不匹配；停止派单。")
    print(f"已同步：ID={uid} version={version}；旧版本保留。")


# ---------------------------------------------------------------- probing

def probe(host):
    if host["platform"] == "windows":
        try:
            return dict(native.request(host, "probe", timeout=25), host=host["name"], reachable=True)
        except (ValueError, subprocess.TimeoutExpired):
            return {"host": host["name"], "reachable": False, "error": "Windows SSH、运行环境或资源探针失败"}
    r = ssh(host, PROBE, check=False, timeout=25)
    info = {"host": host["name"], "reachable": bool(r and r.returncode == 0)}
    if info["reachable"]:
        info.update(kv.split("=", 1) for kv in r.stdout.split() if "=" in kv)
    else:
        info["error"] = ((r.stderr if r else "timeout") or "").strip().splitlines()[-1:] or ["unreachable"]
        info["error"] = info["error"][0]
    return info


def num(v):
    try:
        return float(v)
    except (TypeError, ValueError):
        return None


def assess(host, info):
    """Return a list of reasons this host should not take a new session."""
    if not info["reachable"]:
        return [f"unreachable: {info['error']}"]
    why = []
    load, ncpu = num(info.get("load1")), num(info.get("ncpu"))
    if load is not None and ncpu and load / ncpu > float(host["max_load_per_core"]):
        why.append(f"load {load:.1f} on {int(ncpu)} cores")
    mem = num(info.get("memfree"))
    if mem is not None and mem < float(host["min_free_mem_pct"]):
        why.append(f"only {mem:.0f}% memory free")
    disk = num(info.get("disk"))
    if disk is not None and disk < float(host["min_free_disk_gb"]):
        why.append(f"only {disk:.0f} GB disk free")
    if info.get("os") == "Windows":
        cpu = num(info.get("cpu_pct"))
        if cpu is None:
            why.append("Windows CPU usage unknown")
        elif cpu > float(host["max_cpu_pct"]):
            why.append(f"CPU {cpu:.1f}%")
    if mem is None or disk is None:
        why.append("memory or disk probe unknown")
    return why


def probe_all(hosts):
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as ex:
        return list(zip(hosts, ex.map(probe, hosts)))


def fmt_probe(host, info, why):
    if not info["reachable"]:
        return f"{host['name']:<12} UNREACHABLE  {info['error']}"
    unk = lambda k, suf="": (info.get(k) or "?") + suf
    verdict = "ok" if not why else "busy: " + "; ".join(why)
    cpu = "cpu " + unk("cpu_pct", "%") if info.get("os") == "Windows" else "load " + unk("load1") + "/" + unk("ncpu") + "c"
    return (f"{host['name']:<12} {cpu}  mem-free {unk('memfree', '%')}  "
            f"swap {unk('swap')}  disk {unk('disk', 'G')}  sessions {unk('running')}  "
            f"heavy {unk('heavy')}/{host['max_heavy']}  -> {verdict}")


def pick_host(cfg, name, tags):
    if name and name != "auto":
        host = cfg.host(name)
        info = probe(host)
        why = assess(host, info)
        print(fmt_probe(host, info, why))
        if why:
            die(f"{name} cannot take the job now ({'; '.join(why)}). Wait, or pass --force-host.", 3)
        return host
    hosts = [h for h in cfg.hosts() if set(tags) <= {t.strip() for t in h["tags"].split(",") if t.strip()}]
    if not hosts:
        die(f"no enabled host{' with tags ' + ','.join(tags) if tags else ''} in {CONFIG}")
    free = []
    for host, info in probe_all(hosts):
        why = assess(host, info)
        print(fmt_probe(host, info, why))
        if not why:
            # 没有会话数上限：能不能接由负载、内存、磁盘决定；多台都能接时挑负载最低的。
            per_core = (num(info.get("load1")) or 0) / (num(info.get("ncpu")) or 1)
            free.append((per_core, int(num(info.get("running")) or 0), host["name"], host))
    if not free:
        die("no host can take the job right now; nothing was dispatched.", 3)
    return sorted(free, key=lambda t: t[:3])[0][3]


# ---------------------------------------------------------------- local git

def git(args, repo, check=True, env=None):
    return run(["git", "-C", repo, *args], check=check, env=env)


def local_repo():
    p = run(["git", "rev-parse", "--show-toplevel"], check=False)
    if p.returncode != 0:
        die("run this inside the git repository you want to dispatch from")
    return p.stdout.strip()


def project_name(repo):
    url = git(["remote", "get-url", "origin"], repo, check=False).stdout.strip()
    base = url.rstrip("/").rsplit("/", 1)[-1] if url else os.path.basename(repo)
    name = re.sub(r"\.git$", "", base)
    return re.sub(r"[^A-Za-z0-9._-]", "-", name), url


def git_ssh_env(host):
    return dict(os.environ, GIT_SSH_COMMAND="ssh " + host["ssh_opts"])


# ---------------------------------------------------------------- job records

def job_path(job):
    return os.path.join(STATE, "jobs", job + ".json")


def save_job(rec):
    messages.atomic_json(Path(STATE).resolve() / "jobs" / (messages.job_id(rec["job"]) + ".json"), rec, limit=None)


def load_job(job):
    messages.job_id(job)
    try:
        with open(job_path(job), encoding="utf-8") as f:
            return json.load(f)
    except FileNotFoundError:
        die(f"unknown job '{job}'. See: rd status")


def all_jobs():
    d = os.path.join(STATE, "jobs")
    names = sorted(f[:-5] for f in os.listdir(d) if f.endswith(".json")) if os.path.isdir(d) else []
    return [load_job(n) for n in names]


def initiator_session(args):
    value = getattr(args, "initiator_session", None) or os.environ.get("RD_INITIATOR_SESSION") or os.environ.get("CODEX_THREAD_ID")
    return messages.identifier(value, "发起方会话") if value else None


def require_initiator(rec, args):
    owner = rec.get("initiator_session")
    if owner and initiator_session(args) != owner:
        die("结果和续派属于原发起会话；使用该会话或显式传入 --initiator-session。", 4)


def result_path(rec, number):
    return Path(STATE).resolve() / "results" / messages.job_id(rec["job"]) / ("r" + str(messages.round_id(number)) + ".json")


def remote_report(host, rec, number, kind):
    relative = "reports/" + kind + ".r" + str(messages.round_id(number)) + ".json"
    if host["platform"] == "windows":
        return native.request(host, "report-read", dict(job=rec["job"], round=number, kind=kind))
    path = '"$ROOT/jobs/' + messages.job_id(rec["job"]) + '/' + relative + '"'
    reply = ssh(host, f'if [ -L {path} ]; then exit 4; fi; if [ -f {path} ]; then head -c {messages.MAX_BYTES + 1} {path}; fi', check=False, timeout=30)
    if reply is None or reply.returncode:
        raise ValueError("无法读取远端回执；连接错误不代表任务失败。")
    if not reply.stdout.strip():
        return None
    if len(reply.stdout.encode("utf-8")) > messages.MAX_BYTES:
        raise ValueError("远端回执超过64KiB。")
    return messages.validate_report(json.loads(reply.stdout), rec["job"], number, kind)


def collect_result(cfg, rec, snapshot):
    number = int(snapshot.get("round") or rec["rounds"])
    path = result_path(rec, number)
    cached = messages.read_json(path)
    if cached is not None:
        return cached
    if snapshot.get("state") not in ("done", "dead", "missing"):
        return None
    host = job_host(cfg, rec)
    report = remote_report(host, rec, number, "result") if snapshot.get("state") == "done" and rec.get("handoff_version") else None
    code = snapshot.get("exit")
    receipt = dict(schema=1, job=rec["job"], round=number, host=rec["host"],
                   initiator_session=rec.get("initiator_session"), execution_state=snapshot["state"],
                   executor_exit=int(code) if code not in (None, "") else None,
                   receiver_session=rec.get("receiver_session"), report=report,
                   head=snapshot.get("head"), dirty=snapshot.get("dirty"),
                   captured_at=messages.utc_now(), needs_initiator_review=True)
    if rec.get("agent") and snapshot.get("state") == "done":
        receiver = find_session(host, rec, rec.get("agent_config") or cfg.agent(rec["agent"]))
        if receiver:
            receipt["receiver_session"] = receiver
            rec["receiver_session"] = receiver
            save_job(rec)
    receipt["receipt_id"] = hashlib.sha256(json.dumps(receipt, sort_keys=True, ensure_ascii=False).encode()).hexdigest()
    messages.atomic_json(path, receipt)
    return receipt


def delivery(rec, receipt):
    ack = messages.read_json(result_path(rec, receipt["round"]).with_suffix(".ack.json"))
    return "received" if ack and ack.get("receipt_id") == receipt["receipt_id"] else "pending"


def cmd_result(a, cfg):
    rec = load_job(a.job)
    require_initiator(rec, a)
    job_host(cfg, rec)
    receipt = messages.read_json(result_path(rec, a.round or rec["rounds"]))
    if receipt is None:
        snapshot = job_states(cfg, [rec]).get(rec["job"], {})
        if a.round and int(snapshot.get("round") or rec["rounds"]) != a.round:
            die("该历史轮次尚无本地回执；先在原轮次收取结果。", 4)
        receipt = collect_result(cfg, rec, snapshot)
    if receipt is None:
        die("结果尚未取得；用 rd status 查看运行或连接状态。", 2)
    print(json.dumps(dict(receipt, delivery_state=delivery(rec, receipt)), ensure_ascii=False, indent=2))


def cmd_inbox(a, cfg):
    owner = initiator_session(a)
    if not owner:
        die("inbox 需要 --initiator-session 或 RD_INITIATOR_SESSION。", 4)
    uid = require_user()
    recs = [r for r in all_jobs() if r.get("user_id") == uid and r.get("initiator_session") == owner]
    states = job_states(cfg, recs)
    receipts, unavailable = [], []
    for rec in recs:
        snapshot = states.get(rec["job"], {})
        if snapshot.get("state") == "unreachable":
            unavailable.append(rec["job"])
        else:
            collect_result(cfg, rec, snapshot)
        directory = result_path(rec, 1).parent
        for path in sorted(directory.glob("r*.json")):
            if path.name.endswith(".ack.json"):
                continue
            receipt = messages.read_json(path)
            if delivery(rec, receipt) == "pending":
                receipts.append(dict(receipt, delivery_state="pending"))
    print(json.dumps(dict(initiator_session=owner, results=receipts, unreachable=unavailable), ensure_ascii=False, indent=2))


def cmd_ack(a, cfg):
    rec = load_job(a.job)
    require_initiator(rec, a)
    job_host(cfg, rec)
    path = result_path(rec, a.round)
    receipt = messages.read_json(path)
    if not receipt or receipt["receipt_id"] != a.receipt_id:
        die("回执 ID 或轮次不匹配；先收取并核对 rd result。", 4)
    messages.atomic_json(path.with_suffix(".ack.json"), dict(receipt_id=a.receipt_id, received_at=messages.utc_now()))
    print("结果已由发起方收取；此确认不代表验收通过，不会自动续派。")


# ---------------------------------------------------------------- run / resume

def build_run_script(host, rec, round_no, timeout):
    push = ""
    if rec["sync"] == "origin":
        push = (f'git push origin {shlex.quote("HEAD:refs/heads/" + rec["branch"])} > "$RD_JOB_DIR/push.log" 2>&1; '
                'echo $? > "$RD_JOB_DIR/push_rc"')
    env_file = ""
    if host["env_file"]:
        ef = host["env_file"].replace("~/", "$HOME/", 1)
        env_file = f'[ -f "{ef}" ] && . "{ef}"'
    shared = dict(host, workdir=host.get("shared_workdir", host["workdir"]))
    identity = 'export RD_USER_ID=' + shlex.quote(rec["user_id"]) if rec.get("user_id") else ""
    command = 'sh "$RD_JOB_DIR/cmd.r$RD_ROUND.sh"'
    if rec.get("profile"):
        command = 'python3 "$RD_JOB_DIR/rd_profiles.py" "$RD_JOB_DIR" "$RD_JOB_DIR/cmd.r$RD_ROUND.sh" ' + shlex.quote(host["codex_auth_file"])
    report_env, report_finish = "", ":"
    if rec.get("handoff_version"):
        report_env = 'export RD_REPORTER="$RD_JOB_DIR/rd_messages.py"'
        report_finish = ('printf "%s\\n" "$rc" > "$RD_JOB_DIR/exit.r$RD_ROUND"; '
                         'if command -v python3 >/dev/null 2>&1; then python3 "$RD_REPORTER" finish --exit "$rc" '
                         '>> "$RD_JOB_DIR/report.r$RD_ROUND.log" 2>&1; fi')
    subs = {"JOB": rec["job"], "ROUND": str(round_no), "PATH": host["path"], "ROOT": root_expr(host),
            "MAX_HEAVY": host["max_heavy"], "ENV_FILE": env_file, "KILLTREE": KILLTREE,
            "TIMEOUT": str(int(timeout)), "PUSH": push, "SHARED_ROOT": root_expr(shared),
            "IDENTITY": identity, "EXEC": command, "REPORT_ENV": report_env, "REPORT_FINISH": report_finish}
    text = RUN_TEMPLATE
    for k, v in subs.items():
        text = text.replace(f"@@{k}@@", v)
    return text


def agent_command(agent, model, effort, session=None):
    args = []
    if agent.get("kind") == "codex":
        args += ['--disable hooks --disable plugins --disable memories --disable external_agent_memory_import -c "$RD_CODEX_SQLITE" -c "$RD_CODEX_LOG" -c \'cli_auth_credentials_store="file"\'']
    if model:
        if "model" not in agent:
            die("this agent has no model flag; set the model in its own config on the worker")
        args.append(agent["model"].replace("{model}", shlex.quote(model)))
    if effort:
        if "effort" not in agent:
            die("this agent has no reasoning-effort flag")
        args.append(agent["effort"].replace("{effort}", shlex.quote(effort)))
    tpl = agent["resume"] if session else agent["start"]
    return tpl.replace("{model_args}", " ".join(args)).replace("{session}", shlex.quote(session or ""))


def put_file(host, rel, content, mode="644"):
    if host["platform"] == "windows":
        native.request(host, "upload", {"relative": rel}, payload=content.encode())
        return
    ssh(host, f'mkdir -p "$(dirname "$ROOT/{rel}")" && cat > "$ROOT/{rel}" && chmod {mode} "$ROOT/{rel}"',
        stdin_data=content)


def native_init(host, rec, repo, sha, origin):
    data = {k: rec[k] for k in ("job", "bare", "branch", "sync")}
    if rec["sync"] == "origin":
        if not origin:
            die("Windows origin 同步需要仓库 origin。")
        git(["push", "origin", f"{sha}:refs/heads/{rec['branch']}"], repo)
        result = native.request(host, "init", dict(data, origin=origin), timeout=300)
    elif rec["sync"] == "direct":
        reference = "refs/rd-transfer/" + rec["job"]
        with tempfile.TemporaryDirectory() as temporary:
            bundle = Path(temporary) / "source.bundle"
            git(["update-ref", reference, sha], repo)
            try:
                git(["bundle", "create", str(bundle), reference], repo)
            finally:
                git(["update-ref", "-d", reference, sha], repo)
            with bundle.open("rb") as stream:
                result = native.request(host, "init", dict(data, transfer_ref=reference), payload=stream, timeout=300)
    else:
        die("sync 必须是 origin 或 direct。")
    host["workdir"] = result["root"]
    rec["worker_root"] = result["root"]


def launch(host, rec, round_no, cmd_text, prompt_text, timeout):
    j = rec["job"]
    if rec.get("handoff_version"):
        if prompt_text is not None:
            reporter = 'python3 "$RD_REPORTER"' if host["platform"] != "windows" else '& ' + native.ps_quote(host["python"]) + ' $env:RD_REPORTER'
            prompt_text += ("\n\nRemote Dispatch 本轮交付约定：只完成本轮指令范围内工作，结果回传后等待发起方新指令。"
                           "执行中用 " + reporter + " progress --phase 阶段 --summary 脱敏摘要 记录状态；"
                           "收尾用 " + reporter + " result --outcome completed|partial|blocked|failed "
                           "--checks passed|failed|partial|not_run --summary 脱敏结果 --artifact 证据路径。"
                           "检查状态为执行方报告，最终验收由发起方判断；密码、私钥和敏感正文不写回执。\n")
        with open(os.path.join(HERE, "rd_messages.py"), encoding="utf-8") as stream:
            put_file(host, f"jobs/{j}/rd_messages.py", stream.read(), "600")
        put_file(host, f"jobs/{j}/reports/dispatch.r{round_no}.json", json.dumps(dict(job=j, round=round_no, initiator_session=rec.get("initiator_session"))), "600")
    if host["platform"] == "windows":
        spec = dict(rec, round=round_no, timeout=int(timeout), max_heavy=int(host["max_heavy"]),
                    auth_file=host["codex_auth_file"], env_file=host["env_file"])
        native.request(host, "launch", {"spec": spec, "prompt": prompt_text})
        return
    if rec.get("profile") and round_no == 1:
        put_file(host, f"jobs/{j}/profile.json", json.dumps(rec["profile"]), "600")
        with open(os.path.join(HERE, "rd_profiles.py"), encoding="utf-8") as stream:
            put_file(host, f"jobs/{j}/rd_profiles.py", stream.read(), "600")
    put_file(host, f"jobs/{j}/cmd.r{round_no}.sh", cmd_text + "\n")
    if prompt_text is not None:
        put_file(host, f"jobs/{j}/prompt.r{round_no}.md", prompt_text)
    put_file(host, f"jobs/{j}/run.r{round_no}.sh", build_run_script(host, rec, round_no, timeout), "755")
    with open(os.path.join(HERE, "rd-heavy")) as f:
        put_file(host, "bin/rd-heavy", f.read(), "755")
    script = f'"$ROOT/jobs/{j}/run.r{round_no}.sh"'
    if host["launcher"] == "tmux":
        start = f"tmux new-session -d -s {shlex.quote('rd-' + j + '-r' + str(round_no))} sh {script}"
    elif host["launcher"] == "nohup":
        start = f"nohup sh {script} > /dev/null 2>&1 < /dev/null &"
    else:
        die(f"[host:{host['name']}] launcher must be nohup or tmux")
    ssh(host, f'rm -f "$ROOT/jobs/{j}/exit_code" "$ROOT/jobs/{j}/pid"; {start}')


def cmd_run(a, cfg):
    uid = require_user()
    repo = local_repo()
    project, origin_url = project_name(repo)
    proj = cfg.project(a.project or project)
    project = a.project or project
    if not re.fullmatch(r"[A-Za-z0-9._-]+", project) or project in (".", ".."):
        die("项目名必须是英文、数字、点、下划线或连字符，不得包含路径。", 4)
    if a.test:
        a.cmd = proj.get("test") or die(f"--test needs 'test = <command>' under [project:{project}] in {CONFIG}")
        a.heavy = a.heavy or proj.get("test_heavy", "true").lower() in ("1", "true", "yes")
    if bool(a.agent) == bool(a.cmd):
        die("give exactly one of --agent (with --prompt-file) or --cmd / --test")
    prompt = None
    if a.agent:
        if a.agent != "codex":
            die("员工配置隔离目前只支持 --agent codex；其他代理模板保留，完成专用适配前不得继承宿主个人配置。", 4)
        if not a.prompt_file:
            die("--agent needs --prompt-file")
        prompt = sys.stdin.read() if a.prompt_file == "-" else Path(a.prompt_file).read_text(encoding="utf-8")
        agent = cfg.agent(a.agent)

    ref = a.ref
    if a.wip:
        wip = git(["stash", "create"], repo).stdout.strip()
        ref = wip or ref
        print("wip: sending tracked uncommitted changes" if wip else "wip: working tree is clean, sending " + a.ref)
    sha = git(["rev-parse", "--verify", ref + "^{commit}"], repo).stdout.strip()
    dirty = git(["status", "--porcelain"], repo).stdout.strip()
    if dirty and not a.wip:
        print("note: uncommitted local changes are NOT sent (commit them, or use --wip / --include).")

    stamp = time.strftime("%Y%m%d-%H%M%S") + f"-{time.time_ns() % 1000000000:09d}"
    name = re.sub(r"[^A-Za-z0-9._-]+", "-", a.name or a.agent or "cmd").strip("-")
    job = f"{uid}-{project}-{name}-{stamp}"
    branch = a.branch or f"rd/{uid}/{name}-{stamp}"
    git(["check-ref-format", "--branch", branch], repo)

    host = cfg.host(a.host) if a.force_host and a.host not in (None, "auto") else pick_host(cfg, a.host, a.tag)
    host = scoped_host(host, uid)
    if host["platform"] == "windows" and a.test:
        a.cmd = proj.get("test_windows", a.cmd)
    profile = None
    if a.agent:
        local, _ = local_profile(uid)
        profile = remote_profile(host, uid)
        profile_report(host, uid, local, profile)
        if profile is None:
            die("此 ID 尚无远端配置；先询问是否同步、确认 ID，再执行 rd profile sync。未推送任务分支。", 4)
        if any("{model_args}" not in agent.get(k, "") for k in ("start", "resume")):
            die("Codex 启动与续跑模板必须保留 {model_args}，以执行员工配置隔离开关。", 4)
        if host["platform"] == "windows":
            if any(agent[k] != AGENTS["codex"][k] for k in ("start", "resume")):
                die("Windows 使用内置 Codex 参数适配；自定义 POSIX 启动模板不能直接移植。", 4)
            check = native.request(host, "doctor")
            ready = check["ok"] and check["features"]
        else:
            ready = ssh(host, CODEX_CHECK, check=False).returncode == 0
        if not ready:
            die("目标机必须安装 Python 3.11+ 和支持功能开关的 Codex CLI；未推送任务分支。", 4)
    rec = {"job": job, "host": host["name"], "project": project, "repo": repo, "branch": branch,
           "base": sha, "sync": host["sync"], "agent": a.agent, "cmd": a.cmd, "rounds": 1,
           "created": time.strftime("%Y-%m-%d %H:%M:%S"), "user_id": uid,
           "worker_root": host["workdir"], "shared_root": host["shared_workdir"], "profile": profile,
           "model": a.model, "effort": a.effort, "agent_config": agent if a.agent else None,
           "worker_platform": host["platform"], "worker_python": host["python"], "heavy": a.heavy,
           "handoff_version": 1, "initiator_session": initiator_session(a)}
    print(f"dispatching {job} -> {host['name']} (branch {branch}, base {sha[:10]}, sync {host['sync']})")

    repo_key = hashlib.sha256((origin_url or repo).encode()).hexdigest()[:12]
    bare = f"repos/{project}-{repo_key}.git"
    rec["bare"] = bare
    if host["platform"] == "windows":
        native_init(host, rec, repo, sha, proj.get("origin_url") or origin_url)
        if a.include:
            tar = subprocess.Popen(["tar", "-cf", "-", "-C", repo, *a.include], stdout=subprocess.PIPE,
                                   env=dict(os.environ, COPYFILE_DISABLE="1"))
            try:
                native.request(host, "upload", {"relative": "wt/" + job, "archive": True}, payload=tar.stdout)
            finally:
                tar.stdout.close()
            if tar.wait() != 0:
                die("could not pack --include paths")
        setup = proj.get("setup_windows", proj.get("setup"))
        if setup:
            put_file(host, f"jobs/{job}/setup.ps1", setup)
        save_job(rec)
        launch(host, rec, 1, "", prompt, a.timeout or host["timeout"])
        print(f"started. job id: {job}")
        return
    if host["sync"] == "origin":
        worker_url = proj.get("origin_url") or origin_url or die("this repository has no 'origin' remote")
        git(["push", "origin", f"{sha}:refs/heads/{branch}"], repo)
        prep = (f'[ -d "$ROOT/{bare}" ] || GIT_TERMINAL_PROMPT=0 git clone --bare {shlex.quote(worker_url)} '
                f'"$ROOT/{bare}" || exit 90\n'
                f'GIT_TERMINAL_PROMPT=0 git -C "$ROOT/{bare}" fetch origin '
                f'"+refs/heads/{branch}:refs/heads/{branch}" || exit 91\n')
    elif host["sync"] == "direct":
        ssh(host, f'mkdir -p "$ROOT/repos" && {{ [ -d "$ROOT/{bare}" ] || git init -q --bare "$ROOT/{bare}"; }}')
        git(["push", scp_path(host, bare), f"{sha}:refs/heads/{branch}"], repo, env=git_ssh_env(host))
        prep = ""
    else:
        die(f"[host:{host['name']}] sync must be origin or direct")
    ssh(host, f'mkdir -p "$ROOT/jobs/{job}" "$ROOT/repos" "$ROOT/wt" "$SHARED_ROOT/locks" "$ROOT/bin"\n{prep}'
              f'git -C "$ROOT/{bare}" worktree add -q "$ROOT/wt/{job}" {shlex.quote(branch)} || exit 92')

    if a.include:
        tar = subprocess.Popen(["tar", "-cf", "-", "-C", repo, *a.include], stdout=subprocess.PIPE,
                               env=dict(os.environ, COPYFILE_DISABLE="1"))
        ssh(host, f'tar -xf - -C "$ROOT/wt/{job}"', stdin=tar.stdout)
        if tar.wait() != 0:
            die("could not pack --include paths")
    if proj.get("setup"):
        put_file(host, f"jobs/{job}/setup.sh", proj["setup"] + "\n")

    if a.agent:
        cmd_text = agent_command(agent, a.model, a.effort)
    else:
        cmd_text = ("rd-heavy sh -c " + shlex.quote(a.cmd)) if a.heavy else a.cmd
    save_job(rec)
    launch(host, rec, 1, cmd_text, prompt, a.timeout or host["timeout"])
    print(f"started. job id: {job}")
    print(f"  rd status {job}    rd logs {job}    rd wait {job}    rd fetch {job}")


def remote_state(host, jobs):
    if host["platform"] == "windows":
        try:
            return native.request(host, "state", {"jobs": jobs}, timeout=30)
        except (ValueError, subprocess.TimeoutExpired):
            return {j: {"state": "unreachable"} for j in jobs}
    script = "for J in " + " ".join(map(shlex.quote, jobs)) + r'''; do
  D="$ROOT/jobs/$J"; st=missing
  if [ -d "$D" ]; then
    st=starting
    if [ -f "$D/exit_code" ]; then st=done
    elif [ -f "$D/pid" ] && kill -0 "$(cat "$D/pid")" 2>/dev/null; then st=running
    elif [ -f "$D/pid" ]; then st=dead; fi
  fi
  n=$(ls "$D"/run.r*.sh 2>/dev/null | wc -l | tr -d ' ')
  last=$(tail -n 5 "$D/stdout.r$n.log" 2>/dev/null | awk 'NF{l=$0}END{print l}' | tr '\t' ' ' | cut -c1-200)
  head=$(cat "$D/head" 2>/dev/null); dirty=$(cat "$D/dirty" 2>/dev/null); head_source=recorded
  if [ "$st" = running ] && [ -d "$ROOT/wt/$J" ]; then
    current_head=$(GIT_OPTIONAL_LOCKS=0 git -C "$ROOT/wt/$J" rev-parse HEAD 2>/dev/null)
    if [ -n "$current_head" ]; then
      head=$current_head; head_source=live
      dirty=$(GIT_OPTIONAL_LOCKS=0 git -C "$ROOT/wt/$J" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
    fi
  fi
  setup=; [ -f "$D/setup.sh" ] && { [ -f "$D/setup.done" ] && setup=done || setup=pending; }
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$J" "$st" "$(cat "$D/exit_code" 2>/dev/null)" \
    "$([ -f "$D/timed_out" ] && echo yes)" "$(cat "$D/push_rc" 2>/dev/null)" "$head" \
    "$dirty" "$n" "$setup" "$last" "$head_source" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
done'''
    r = ssh(host, script, check=False, timeout=30)
    out = {}
    if not r or r.returncode != 0:
        return {j: {"state": "unreachable"} for j in jobs}
    keys = ["job", "state", "exit", "timed_out", "push_rc", "head", "dirty", "round", "setup", "last", "head_source", "observed_at"]
    for line in r.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) == len(keys):
            out[parts[0]] = dict(zip(keys, parts))
    return out


def job_states(cfg, recs):
    by_host = {}
    for r in recs:
        key = (r["host"], r.get("user_id"), r.get("worker_root"))
        if key not in by_host:
            by_host[key] = (job_host(cfg, r), [])
        by_host[key][1].append(r["job"])
    states = {}
    for host, jobs in by_host.values():
        states.update(remote_state(host, jobs))
    return states


def describe(rec, st):
    s = st.get("state", "?")
    bits = [f"{rec['job']}  [{rec['host']}]  {s}"]
    if rec.get("user_id"):
        bits.append("ID=" + rec["user_id"])
    if s == "done":
        code = st.get("exit")
        label = {"0": "ok", "124": "timed out", "97": "setup failed", "98": "profile/auth setup failed", "96": "worktree missing", "143": "stopped"}.get(code, "failed")
        bits.append(f"exit {code} ({label})")
        if rec.get("handoff_version"):
            bits.append("等待发起方收取与判断；检查状态以结果回执为准")
    if st.get("setup") == "pending" and s == "running":
        bits.append("running setup")
    if st.get("head"):
        bits.append("no new commits" if st["head"] == rec["base"] else f"new commits (head {st['head'][:10]})")
    if st.get("dirty") not in (None, "", "0"):
        bits.append(f"{st['dirty']} uncommitted file(s) left in worktree")
    if rec["sync"] == "origin" and st.get("push_rc") not in (None, "", "0"):
        bits.append("PUSH FAILED (see: rd logs JOB --file push.log)")
    line = "  ".join(bits)
    if s == "running" and st.get("last"):
        line += f"\n    last output: {st['last']}"
    return line


def cmd_status(a, cfg):
    recs = [load_job(a.job)] if a.job else [r for r in all_jobs() if not r.get("user_id") or r["user_id"] == require_user()]
    if not recs:
        print("no jobs.")
        return
    states = job_states(cfg, recs)
    if getattr(a, "details", False):
        output = []
        for rec in recs:
            require_initiator(rec, a)
            snapshot = states.get(rec["job"], {})
            progress = remote_report(job_host(cfg, rec), rec, int(snapshot.get("round") or rec["rounds"]), "progress") if rec.get("handoff_version") and snapshot.get("state") in ("running", "done") else None
            receipt = collect_result(cfg, rec, snapshot)
            output.append(dict(job=rec["job"], initiator_session=rec.get("initiator_session"), execution=snapshot,
                               progress=progress, result=receipt, delivery_state=delivery(rec, receipt) if receipt else "not_available"))
        print(json.dumps(output, ensure_ascii=False, indent=2))
        return
    if a.json:
        print(json.dumps([dict(r, **states.get(r["job"], {})) for r in recs], indent=2, ensure_ascii=False))
        return
    for r in recs:
        print(describe(r, states.get(r["job"], {})))


def cmd_wait(a, cfg):
    rec = load_job(a.job)
    deadline = time.time() + a.timeout if a.timeout else None
    while True:
        st = job_states(cfg, [rec]).get(rec["job"], {})
        if st.get("state") in ("done", "dead", "missing"):
            print(describe(rec, st))
            sys.exit(0 if st.get("exit") == "0" else 1)
        if deadline and time.time() > deadline:
            print(describe(rec, st))
            sys.exit(2)
        time.sleep(a.interval)


def cmd_watch(a, cfg):
    """Wake the initiating harness for one shared progress check or a completion."""
    timeout = a.timeout if a.timeout is not None else cfg.report_interval()
    if timeout <= 0:
        die("watch timeout must be positive", 4)
    uid = require_user()
    recs = [load_job(job) for job in dict.fromkeys(a.jobs)]
    if any(rec.get("user_id") != uid for rec in recs):
        die("watch only accepts jobs belonging to RD_USER_ID", 4)
    deadline = time.monotonic() + timeout
    while True:
        states = job_states(cfg, recs)
        finished = [rec["job"] for rec in recs if states.get(rec["job"], {}).get("state") in ("done", "dead", "missing")]
        unavailable = any(states.get(rec["job"], {}).get("state", "unreachable") == "unreachable" for rec in recs)
        now = time.monotonic()
        keep = getattr(a, "keep_on_disconnect", False)
        event = "task_finished" if finished else "monitor_error" if unavailable and not keep else "progress_due" if now >= deadline else None
        if event:
            jobs = [{key: rec[key] for key in ("job", "host", "project", "branch") if key in rec} for rec in recs]
            for rec, snapshot in zip(recs, jobs):
                state = states.get(rec["job"], {})
                snapshot.update({key: state[key] for key in ("state", "exit", "round", "timed_out", "push_rc") if key in state})
                snapshot.setdefault("state", "unreachable")
                if rec.get("handoff_version"):
                    snapshot.update(initiator_session=rec.get("initiator_session"),
                                    result_ready=state.get("state") == "done", needs_initiator_review=True)
            print(json.dumps({"event": event, "finished": finished, "jobs": jobs}, ensure_ascii=False), flush=True)
            failed = (unavailable and not keep) or any(states[job].get("exit") != "0" for job in finished)
            sys.exit(1 if failed else 0 if finished else 2)
        time.sleep(min(30, deadline - now))


def cmd_logs(a, cfg):
    rec = load_job(a.job)
    host = job_host(cfg, rec)
    rnd = a.round or rec["rounds"]
    name = a.file or {"out": f"stdout.r{rnd}.log", "err": f"stderr.r{rnd}.log", "setup": "setup.log",
                      "last": f"last.r{rnd}.txt"}[a.stream]
    if not re.fullmatch(r"[A-Za-z0-9._-]+", name):
        die("bad file name")
    if host["platform"] == "windows":
        print(native.request(host, "logs", {"job": rec["job"], "file": name, "lines": int(a.lines)}))
        return
    r = ssh(host, f'tail -n {int(a.lines)} "$ROOT/jobs/{rec["job"]}/{name}"', check=False)
    sys.stdout.write(r.stdout if r.returncode == 0 else f"(no {name} yet)\n")


def find_session(host, rec, agent):
    if host["platform"] == "windows":
        output = native.request(host, "sessions", {"job": rec["job"]})
        matched = re.search(agent["session_regex"], output)
        return matched.group(1) if matched else None
    r = ssh(host, f'head -c 200000 "$ROOT/jobs/{rec["job"]}"/stdout.r*.log 2>/dev/null', check=False)
    m = re.search(agent["session_regex"], r.stdout or "")
    return m.group(1) if m else None


def cmd_resume(a, cfg):
    rec = load_job(a.job)
    require_initiator(rec, a)
    require_user()
    if not rec.get("user_id") or not rec.get("profile"):
        die("旧任务未固定员工配置；查看、取回仍可用，续跑必须重新派单。", 4)
    if not rec.get("agent"):
        die("only agent jobs can be resumed; start a new job for commands")
    host = job_host(cfg, rec)
    st = remote_state(host, [rec["job"]]).get(rec["job"], {})
    if st.get("state") in ("running", "starting"):
        die("the job is still running; rd stop it first or wait")
    if st.get("state") in ("missing", "unreachable"):
        die(f"job is {st.get('state')} on {host['name']}")
    info = probe(host)
    why = assess(host, info)
    print(fmt_probe(host, info, why))
    if why and not a.force_host:
        die(f"{host['name']} cannot take the session now ({'; '.join(why)}).", 3)
    agent = rec.get("agent_config") or cfg.agent(rec["agent"])
    session = a.session or find_session(host, rec, agent)
    if not session:
        die("could not find the agent's session id in the logs; pass --session ID")
    known = rec.get("receiver_session") or (find_session(host, rec, agent) if rec.get("handoff_version") else None)
    if known and session != known:
        die("续派必须复用原接收会话；指定 --session 与原会话不匹配。", 4)
    if rec.get("handoff_version"):
        collect_result(cfg, rec, st)
    rec["receiver_session"] = session
    prompt = sys.stdin.read() if a.prompt_file == "-" else Path(a.prompt_file).read_text(encoding="utf-8")
    rec["rounds"] += 1
    if host["platform"] == "windows":
        rec["session"] = session
        rec["model"] = a.model or rec.get("model")
        rec["effort"] = a.effort or rec.get("effort")
    save_job(rec)
    launch(host, rec, rec["rounds"], agent_command(agent, a.model or rec.get("model"), a.effort or rec.get("effort"), session), prompt,
           a.timeout or host["timeout"])
    print(f"resumed {rec['job']} (round {rec['rounds']}, session {session})")


def cmd_fetch(a, cfg):
    rec = load_job(a.job)
    host = job_host(cfg, rec)
    repo, b = rec["repo"], rec["branch"]
    spec = f"+refs/heads/{b}:refs/remotes/rd/{b}"
    if rec["sync"] == "origin":
        git(["fetch", "origin", spec], repo)
    elif host["platform"] == "windows":
        with tempfile.TemporaryDirectory() as temporary:
            bundle = Path(temporary) / "result.bundle"
            with bundle.open("wb") as stream:
                native.request(host, "fetch-bundle", {"bare": rec["bare"], "branch": b}, output=stream)
            git(["fetch", str(bundle), spec], repo)
    else:
        git(["fetch", scp_path(host, rec.get("bare", f"repos/{rec['project']}.git")), spec], repo, env=git_ssh_env(host))
    log = git(["log", "--oneline", f"{rec['base']}..rd/{b}"], repo).stdout.strip()
    print(f"fetched into rd/{b}")
    print(log if log else "(no commits on top of the dispatched base)")
    if log:
        print(f"review: git diff {rec['base'][:10]}..rd/{b}     take it: git merge --ff-only rd/{b}")


def cmd_stop(a, cfg):
    rec = load_job(a.job)
    require_initiator(rec, a)
    host = job_host(cfg, rec)
    if host["platform"] == "windows":
        native.request(host, "stop", {"job": rec["job"]})
        print("stopped or already finished")
        return
    r = ssh(host, KILLTREE + f'; D="$ROOT/jobs/{rec["job"]}"; p=$(cat "$D/pid" 2>/dev/null); '
            'if [ -n "$p" ] && kill -0 "$p" 2>/dev/null; then killtree "$p"; echo 143 > "$D/exit_code"; '
            'echo stopped; else echo "not running"; fi')
    print(r.stdout.strip())


def cmd_clean(a, cfg):
    rec = load_job(a.job)
    host = job_host(cfg, rec)
    j, b = rec["job"], rec["branch"]
    st = remote_state(host, [j]).get(j, {})
    if st.get("state") in ("running", "starting"):
        die("the job is still running; rd stop it first")
    if st.get("state") == "unreachable":
        die(f"{host['name']} is unreachable; nothing was removed")
    if rec.get("handoff_version") and not a.force:
        require_initiator(rec, a)
        receipt = collect_result(cfg, rec, st)
        if not receipt or delivery(rec, receipt) != "received":
            die("先用 rd result 收取结果，再用 rd ack 确认；未交付回执不清理。", 4)
    if st.get("state") != "missing" and not a.force:
        if host["platform"] == "windows":
            info = native.request(host, "clean-check", {"job": j})
            dirty, head = str(info["dirty"]), info["head"]
        else:
            r = ssh(host, f'git -C "$ROOT/wt/{j}" status --porcelain 2>/dev/null | wc -l; '
                      f'git -C "$ROOT/wt/{j}" rev-parse HEAD 2>/dev/null', check=False)
            lines = r.stdout.split()
            dirty, head = (lines + ["0", ""])[:2]
        if dirty.strip() != "0":
            die(f"{dirty.strip()} uncommitted file(s) in the remote worktree would be lost. Check them, or --force.")
        have = git(["rev-parse", "-q", "--verify", f"refs/remotes/rd/{b}"], rec["repo"], check=False).stdout.strip()
        if head and head != rec["base"] and head != have:
            die("the job has commits you have not fetched. Run rd fetch first, or --force.")
    bare = rec.get("bare", f"repos/{rec['project']}.git")
    drop = f'git -C "$ROOT/{bare}" branch -q -D {shlex.quote(b)} 2>/dev/null; ' if a.delete_branch else ""
    if host["platform"] == "windows":
        native.request(host, "clean", {"job": j, "bare": bare, "branch": b, "delete_branch": a.delete_branch})
    else:
        ssh(host, f'git -C "$ROOT/{bare}" worktree remove --force "$ROOT/wt/{j}" 2>/dev/null; '
                  f'git -C "$ROOT/{bare}" worktree prune; {drop}rm -rf "$ROOT/jobs/{j}"')
    if a.delete_branch and rec["sync"] == "origin":
        git(["push", "origin", "--delete", b], rec["repo"], check=False)
    os.remove(job_path(j))
    print(f"cleaned {j}" + (" and deleted branch " + b if a.delete_branch else f" (branch {b} kept)"))


def cmd_hosts(a, cfg):
    hosts = cfg.hosts()
    if not hosts:
        die(f"no hosts configured. Add a [host:NAME] section to {CONFIG}")
    for host, info in probe_all(hosts):
        print(fmt_probe(host, info, assess(host, info)))


def cmd_doctor(a, cfg):
    host = cfg.host(a.host)
    if host["platform"] == "windows":
        info = native.request(host, "doctor")
        print(json.dumps(info, indent=2, ensure_ascii=False))
        status = probe(host)
        print(fmt_probe(host, status, assess(host, status)))
        sys.exit(0 if info["ok"] and info["features"] else 1)
    agents = a.agent or list(AGENTS)
    checks = ['ok() { echo "  ok    $1"; }; bad() { echo "  MISSING  $1"; fail=1; }; fail=0',
              'command -v git >/dev/null && ok "git $(git --version | cut -d" " -f3)" || bad git',
              'command -v pgrep >/dev/null && ok pgrep || bad "pgrep (needed for timeouts and rd stop)"']
    if host["launcher"] == "tmux":
        checks.append('command -v tmux >/dev/null && ok tmux || bad "tmux (launcher = tmux)"')
    for name in agents:
        b = cfg.agent(name)["bin"]
        opt = "" if a.agent else " (only needed if you dispatch to it)"
        checks.append(f'command -v {shlex.quote(b)} >/dev/null && ok "agent {name}: $(command -v {shlex.quote(b)})" '
                      f'|| echo "  absent   agent {name}{opt}"')
        if name == "codex":
            checks.append("( " + CODEX_CHECK + ' ) >/dev/null 2>&1 && ok "Codex profile runtime" || bad "Python 3.11+ / Codex isolation features"')
    url = None
    if host["sync"] == "origin":
        p = run(["git", "rev-parse", "--show-toplevel"], check=False)
        if p.returncode == 0:
            project, origin_url = project_name(p.stdout.strip())
            url = cfg.project(project).get("origin_url") or origin_url
        if url:
            checks.append(f'GIT_TERMINAL_PROMPT=0 git ls-remote {shlex.quote(url)} HEAD >/dev/null 2>&1 '
                          f'&& ok "can read {url}" || bad "git access to {url} (worker needs its own credentials '
                          f'with push rights, or use sync = direct)"')
        else:
            checks.append('echo "  skipped  origin access (run rd doctor inside the repository to test it)"')
    checks.append("exit $fail")
    print(f"{host['name']} ({host['ssh']}), sync = {host['sync']}, launcher = {host['launcher']}")
    r = ssh(host, "\n".join(checks), check=False, timeout=60)
    if r is None:
        die("timed out")
    sys.stdout.write(r.stdout or r.stderr)
    info = probe(host)
    print(fmt_probe(host, info, assess(host, info)))
    sys.exit(r.returncode)


def main():
    if os.name == "nt":
        sys.stdout.reconfigure(encoding="utf-8")
        sys.stderr.reconfigure(encoding="utf-8")
    ap = argparse.ArgumentParser(prog="rd", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="command", required=True)

    sub.add_parser("hosts", help="probe every configured machine").set_defaults(fn=cmd_hosts)

    p = sub.add_parser("profile", help="检查或确认同步员工 Codex 配置（不自动同步）")
    p.add_argument("action", choices=["check", "sync"])
    p.add_argument("host")
    p.add_argument("--confirm-user-id", help="用户明确确认后的员工 ID，必须等于 RD_USER_ID")
    p.add_argument("--confirm-version", help="用户审阅的本地完整配置指纹，来自 profile check")
    p.set_defaults(fn=cmd_profile)

    p = sub.add_parser("doctor", help="check that a machine has what a job needs")
    p.add_argument("host")
    p.add_argument("--agent", action="append", help="require this agent (repeatable)")
    p.set_defaults(fn=cmd_doctor)

    p = sub.add_parser("run", help="dispatch an agent session or a command")
    p.add_argument("--agent", help=f"agent to run ({', '.join(AGENTS)}, or one from the config)")
    p.add_argument("--prompt-file", help="prompt for the agent ('-' reads stdin)")
    p.add_argument("--cmd", help="shell command to run instead of an agent")
    p.add_argument("--test", action="store_true", help="run the project's configured test command")
    p.add_argument("--heavy", action="store_true", help="hold a heavy slot while the command runs")
    p.add_argument("--host", default="auto", help="machine name, or auto (default)")
    p.add_argument("--force-host", action="store_true", help="skip the load check for --host")
    p.add_argument("--tag", action="append", default=[], help="only machines with this tag (repeatable)")
    p.add_argument("--ref", default="HEAD", help="commit to send (default HEAD)")
    p.add_argument("--wip", action="store_true", help="also send tracked uncommitted changes")
    p.add_argument("--branch", help="branch the job works on (default rd/<name>-<time>)")
    p.add_argument("--name", help="short label used in the job id")
    p.add_argument("--project", help="project name (default: name of the origin repository)")
    p.add_argument("--include", action="append", default=[], help="extra untracked path to copy (repeatable)")
    p.add_argument("--model")
    p.add_argument("--effort")
    p.add_argument("--timeout", type=int, help="seconds before the job is killed")
    p.add_argument("--initiator-session", help="发起方会话ID；默认 RD_INITIATOR_SESSION，再 CODEX_THREAD_ID")
    p.set_defaults(fn=cmd_run)

    p = sub.add_parser("status", help="show jobs")
    p.add_argument("job", nargs="?")
    p.add_argument("--json", action="store_true")
    p.add_argument("--details", action="store_true", help="返回本轮进度/结果，要求原发起会话")
    p.add_argument("--initiator-session")
    p.set_defaults(fn=cmd_status)

    p = sub.add_parser("wait", help="block until a job finishes (exit 0 ok, 1 failed, 2 still running)")
    p.add_argument("job")
    p.add_argument("--timeout", type=int)
    p.add_argument("--interval", type=int, default=30)
    p.set_defaults(fn=cmd_wait)

    p = sub.add_parser("watch", help="initiator-side shared progress wake-up (0 completed, 1 alert, 2 progress due)")
    p.add_argument("jobs", nargs="+", help="explicit jobs monitored by this initiator")
    p.add_argument("--timeout", type=int, help="override this wait in seconds; otherwise use RD_REPORT_INTERVAL_SECONDS, [monitor] report_interval_seconds, or 900")
    p.add_argument("--keep-on-disconnect", action="store_true", help="短期不可达时保留本次巡检截止时间，继续只读观察")
    p.set_defaults(fn=cmd_watch)

    p = sub.add_parser("logs", help="show the tail of a job's output")
    p.add_argument("job")
    p.add_argument("stream", nargs="?", default="out", choices=["out", "err", "setup", "last"])
    p.add_argument("-n", "--lines", default=40)
    p.add_argument("--round", type=int)
    p.add_argument("--file", help="any file in the job directory, e.g. push.log")
    p.set_defaults(fn=cmd_logs)

    p = sub.add_parser("result", help="收取本轮结果；执行退出不等于验收通过")
    p.add_argument("job")
    p.add_argument("--round", type=int)
    p.add_argument("--initiator-session")
    p.set_defaults(fn=cmd_result)

    p = sub.add_parser("inbox", help="列出当前发起会话待收取的结果")
    p.add_argument("--initiator-session")
    p.set_defaults(fn=cmd_inbox)

    p = sub.add_parser("ack", help="确认已收取特定回执，不自动验收或续派")
    p.add_argument("job")
    p.add_argument("--round", type=int, required=True)
    p.add_argument("--receipt-id", required=True)
    p.add_argument("--initiator-session")
    p.set_defaults(fn=cmd_ack)

    p = sub.add_parser("resume", help="continue an agent job in the same session")
    p.add_argument("job")
    p.add_argument("--prompt-file", required=True)
    p.add_argument("--session", help="session id, if it cannot be found in the logs")
    p.add_argument("--model")
    p.add_argument("--effort")
    p.add_argument("--timeout", type=int)
    p.add_argument("--force-host", action="store_true")
    p.add_argument("--initiator-session")
    p.set_defaults(fn=cmd_resume)

    p = sub.add_parser("fetch", help="bring the job's commits back as rd/<branch>")
    p.add_argument("job")
    p.set_defaults(fn=cmd_fetch)

    p = sub.add_parser("stop", help="kill a running job")
    p.add_argument("job")
    p.add_argument("--initiator-session")
    p.set_defaults(fn=cmd_stop)

    p = sub.add_parser("clean", help="remove a finished job's worktree and logs from the worker")
    p.add_argument("job")
    p.add_argument("--delete-branch", action="store_true", help="also delete the job branch (worker and origin)")
    p.add_argument("--force", action="store_true", help="discard uncommitted or unfetched work")
    p.add_argument("--initiator-session")
    p.set_defaults(fn=cmd_clean)

    a = ap.parse_args()
    try:
        a.fn(a, Config())
    except ValueError as error:
        die(str(error), 4)


if __name__ == "__main__":
    main()
