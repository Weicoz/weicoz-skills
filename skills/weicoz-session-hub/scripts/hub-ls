#!/usr/bin/env python3
"""列出带总控登记标签的 Herdr pane，用于上下文丢失后恢复工作线。支持 macOS、Linux、Windows。

用法：hub-ls [标签前缀]      默认前缀 "hub|"；只看某个总控时传 "hub|<总控 pane ID>|"
Windows 运行：python scripts\\hub-ls
输出每行：pane ID、代理状态、工作线、登记状态、会话名、完整标签。
"""
import json
import os
import subprocess
import sys


def main():
    prefix = sys.argv[1] if len(sys.argv) > 1 else "hub|"
    if os.environ.get("HERDR_ENV") != "1":
        print("错误：当前不在 Herdr 管理的 pane 内（HERDR_ENV 不等于 1），不操作 Herdr 会话。", file=sys.stderr)
        return 2
    try:
        out = subprocess.run(["herdr", "pane", "list"], capture_output=True, text=True,
                             encoding="utf-8", timeout=15, check=True).stdout
        panes = json.loads(out)["result"]["panes"]
    except (OSError, subprocess.SubprocessError, ValueError, KeyError) as e:
        print(f"错误：读取 herdr pane list 失败：{e}", file=sys.stderr)
        return 2
    found = 0
    for p in panes:
        label = p.get("label") or ""
        if not label.startswith(prefix):
            continue
        parts = label.split("|") + [""] * 5
        print("\t".join([p["pane_id"], p.get("agent_status", "unknown"), parts[2], parts[3], parts[4], label]))
        found += 1
    if not found:
        print(f"没有以 {prefix!r} 开头的登记标签。")
    return 0


if __name__ == "__main__":
    sys.exit(main())
