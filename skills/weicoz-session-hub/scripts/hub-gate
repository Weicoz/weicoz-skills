#!/usr/bin/env python3
"""会话总控准入检查：判断本机是否还能新开会话或派重活。

四项任一不达标即不放行（退出码 3）；全部达标退出码 0；无法采集退出码 2。
阈值与 weicoz-remote-dispatch 的 rd 默认值一致，可用环境变量覆盖：
  SESSION_HUB_MAX_LOAD_PER_CORE  默认 1.5
  SESSION_HUB_MIN_FREE_MEM_PCT   默认 10
  SESSION_HUB_MIN_FREE_DISK_GB   默认 10
  SESSION_HUB_MAX_SWAP_USED_GB   默认 15
  SESSION_HUB_DISK_PATH          默认当前目录
"""
import os
import platform
import re
import shutil
import subprocess
import sys


def env_float(name, default):
    raw = os.environ.get(name, "")
    try:
        return float(raw) if raw else default
    except ValueError:
        sys.exit(f"错误：环境变量 {name}={raw!r} 不是数字。")


def run(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def probe():
    """返回 (load1, ncpu, mem_free_pct, swap_used_gb)，取不到的项为 None。"""
    load1 = os.getloadavg()[0] if hasattr(os, "getloadavg") else None
    ncpu = os.cpu_count()
    mem = swap = None
    system = platform.system()
    if system == "Darwin":
        m = re.search(r"free percentage:\s*(\d+)", run(["memory_pressure"]))
        mem = float(m.group(1)) if m else None
        m = re.search(r"used = ([\d.]+)M", run(["sysctl", "-n", "vm.swapusage"]))
        swap = float(m.group(1)) / 1024 if m else None
    elif system == "Linux":
        info = {}
        try:
            with open("/proc/meminfo") as f:
                for line in f:
                    k, v = line.split(":", 1)
                    info[k] = float(v.split()[0])
        except OSError:
            pass
        if info.get("MemTotal"):
            mem = info.get("MemAvailable", 0) * 100 / info["MemTotal"]
        if "SwapTotal" in info:
            swap = (info["SwapTotal"] - info.get("SwapFree", 0)) / 1024 / 1024
    return load1, ncpu, mem, swap


def main():
    max_load = env_float("SESSION_HUB_MAX_LOAD_PER_CORE", 1.5)
    min_mem = env_float("SESSION_HUB_MIN_FREE_MEM_PCT", 10)
    min_disk = env_float("SESSION_HUB_MIN_FREE_DISK_GB", 10)
    max_swap = env_float("SESSION_HUB_MAX_SWAP_USED_GB", 15)
    disk_path = os.environ.get("SESSION_HUB_DISK_PATH") or os.getcwd()

    load1, ncpu, mem, swap = probe()
    disk = shutil.disk_usage(disk_path).free / 1024 ** 3

    rows, blocked, unknown = [], [], []

    def check(name, ok, text):
        rows.append(f"{'通过' if ok else '超标'}  {name}：{text}")
        if not ok:
            blocked.append(name)

    if load1 is None or not ncpu:
        unknown.append("每核负载")
    else:
        per = load1 / ncpu
        check("每核负载", per <= max_load,
              f"1 分钟负载 {load1:.2f} ÷ {ncpu} 核 = {per:.2f}，阈值 {max_load}（大于 1 表示有进程排队等 CPU）")
    if mem is None:
        unknown.append("空闲内存")
    else:
        check("空闲内存", mem >= min_mem, f"{mem:.0f}%，下限 {min_mem:.0f}%")
    check("可用磁盘", disk >= min_disk, f"{disk:.1f} GB（{disk_path}），下限 {min_disk:.0f} GB")
    if swap is None:
        unknown.append("已用交换")
    else:
        check("已用交换", swap <= max_swap, f"{swap:.1f} GB，上限 {max_swap:.0f} GB")

    print("\n".join(rows))
    for name in unknown:
        print(f"未确认  {name}：本平台无法采集，请人工检查")
    if blocked:
        print(f"结论：不放行（{'、'.join(blocked)}超标）。默认不新开会话，告诉用户原因；用户明确要求强制时才开。")
        return 3
    if unknown:
        print("结论：未确认（部分指标无法采集），由用户决定是否继续。")
        return 2
    print("结论：放行。")
    return 0


if __name__ == "__main__":
    sys.exit(main())
