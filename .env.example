# 本文件只列变量名，不放真实值。真实值保存在本机 ~/.zshrc。
# 飞书收款 / 工资 skill 的私有配置（Base token、table id、比例等都在文件内，不进环境变量）
# 默认位置：~/.config/weicoz-feishu-receipt-base/config.yaml 与 ~/.config/weicoz-feishu-salary-base/config.yaml
# 下面两个变量只在需要改位置时设置。
WEICOZ_RECEIPT_CONFIG=
WEICOZ_SALARY_CONFIG=
WEICOZ_FRP_SERVER_ADDR=
WEICOZ_FRP_REMOTE_USER=
WEICOZ_FRP_REMOTE_DIR=
WEICOZ_FRP_BIN=
WEICOZ_SKILLS_ROOT=
WEICOZ_SKILLS_MANAGER_ROOT=
WEICOZ_KNOWLEDGE_ROOT=
WEICOZ_JY_DESIGN_ROOT=
WEICOZ_CODEX_ROOT=
WEICOZ_BROWSER_STATE_ROOT=
WEICOZ_BB_BROWSER_ROOT=
WEICOZ_DOCUMENTS_RENDERER=
WEICOZ_OFFICIAL_LAST30DAYS_SKILL=
# 可选；未配置时，输出类 skill 使用当前目录。
WEICOZ_OUTPUT_ROOT=
WEICOZ_WECHAT_SAVE_REPO_ROOT=
WEICOZ_WECHAT_SAVE_SSH_TARGET=
WEICOZ_WECHAT_SAVE_SSH_KEY=
WEICOZ_WECHAT_SAVE_REMOTE_DIR=
WEICOZ_WECHAT_SAVE_PM2_APP=
WEICOZ_WECHAT_SAVE_REMOTE_PORT=
WEICOZ_WECHAT_SAVE_LOCAL_DB_URL=
WEICOZ_WECHAT_SAVE_LOCAL_DB_NAME=
WEICOZ_WECHAT_SAVE_LOCAL_PG_CONTAINER=
WEICOZ_WECHAT_SAVE_DB_CONTAINER=
WEICOZ_WECHAT_SAVE_DB_NAME=
WEICOZ_SEMRUSH_PROXY_HOST=
WEICOZ_SEMRUSH_FID=
WEICOZ_CONTRACT_VENDOR_CONTACT=
WEICOZ_CONTRACT_VENDOR_EMAIL=

# weicoz-session-recall 环境变量
SESSION_RECALL_API_URL=
SESSION_RECALL_API_KEY=
SESSION_RECALL_PROTOCOL=          # chat (OpenAI Chat Completions) 或 respond (OpenAI Responses API)，留空自适应
SESSION_RECALL_MODEL=
SESSION_RECALL_ACTIVE_MS=
SESSION_RECALL_STATE_DIR=

# Remote Dispatch 发起方统一巡检周期（秒），优先于本机[monitor]配置；留空默认900秒。
RD_REPORT_INTERVAL_SECONDS=
# 本机 launch-local.sh 每核负载上限；命令行优先，留空默认1.5。
RD_MAX_LOAD_PER_CORE=
# weicoz-agent-implement launch-local.sh：本机同时运行的 Codex 实现会话上限，默认 2，0 表示不限
WEICOZ_MAX_LOCAL_SESSIONS=
# Remote Dispatch 外网必需地址，逗号或空白分隔；留空默认 PyPI，并始终追加当前模型服务。
RD_NETWORK_URLS=
# 模型服务 HTTPS 地址覆盖；留空读取远端该员工活动 provider 的 base_url，再回退 OPENAI_BASE_URL / ChatGPT。
RD_NETWORK_MODEL_URL=
# Codex WebSocket TLS 探测地址覆盖，支持 HTTPS/WSS；留空按模型服务推导。
RD_NETWORK_WEBSOCKET_URL=
# 所有外网目标并行探测的共享超时（秒），留空默认5秒。
RD_NETWORK_TIMEOUT_SECONDS=
# watch 连续只有网络重连、无其他进展的告警阈值（秒），留空默认600秒；不停止任务。
RD_NETWORK_STALL_SECONDS=
# 远端模型服务的标准可选回退地址；仅在未配置 RD_NETWORK_MODEL_URL 且员工 provider 未指定 base_url 时读取。
OPENAI_BASE_URL=
# 发起方会话ID。显式CLI参数优先；留空时仅在宿主提供CODEX_THREAD_ID时自动绑定。
RD_INITIATOR_SESSION=
# 同类且未开始工作的模型故障，默认只允许1次原会话续跑；非负整数。
RD_MAX_SAME_FAILURE_RESUMES=
# rd clean 的本机报告备份根目录；留空默认 ~/.local/share/remote-dispatch/reports。
RD_REPORTS_DIR=

# weicoz-session-hub 准入检查阈值（scripts/hub-gate；留空用默认值，与 rd 默认一致）
SESSION_HUB_MAX_LOAD_PER_CORE=     # 每核负载上限，默认 1.5
SESSION_HUB_MAX_CPU_PCT=           # Windows CPU 采样利用率上限（%），默认 85
SESSION_HUB_MIN_FREE_MEM_PCT=      # 空闲内存下限（%），默认 10
SESSION_HUB_MIN_FREE_DISK_GB=      # 可用磁盘下限（GB），默认 10
SESSION_HUB_MAX_SWAP_USED_GB=      # 已用交换上限（GB），默认 15
SESSION_HUB_DISK_PATH=             # 检查磁盘的路径，默认当前目录

# weicoz-harness-config-sync：入口漂移检查（可选，相对 HOME）
# 维护源，默认 .agents/AGENTS.md
HARNESS_AGENTS_SOURCE=
# 以 : 分隔的入口清单，默认 .codex/AGENTS.md:.dsh/AGENTS.md:.kimi-code/AGENTS.md:.gemini/AGENTS.md:.grok/AGENTS.md
HARNESS_AGENTS_ENTRIES=

# weicoz-ui-studio：可选，覆盖素材服务的 origin（JSON 对象；留空用原始公开服务）
UI_STUDIO_MEDIA_ORIGINS=
# 本机 Chromium/Chrome/Edge 路径（沿用 Free 取证工具变量；留空自动发现）
CHROME_PATH=
# weicoz-herdr-hub：状态目录，默认 $HOME/.local/state/weicoz-herdr-hub
WEICOZ_HERDR_HUB_STATE_DIR=
# 总控标识，默认取 HERDR_PANE_ID
WEICOZ_HERDR_HUB_OWNER=
# 推送渠道，传给 harness-notify --harness，默认 dsh
WEICOZ_HERDR_HUB_NOTIFY_HARNESS=
# 疑似卡住阈值（分钟），默认 40
WEICOZ_HERDR_HUB_STALL_MINUTES=


# weicoz-skill-tiers：分层数据根目录（manifest、library、generated、backups），默认 ~/.agents/skill-tiers
SKILL_TIERS_HOME=

# weicoz-zero-tts：远端 GPU 语音合成 (GPT-SoVITS api_v2)
# 多个端点逗号分隔，优先首选；留空默认回退至 http://127.0.0.1:9880/tts
ZERO_TTS_API_URL=
# 默认音色预设（留空默认 zhongli）
ZERO_TTS_DEFAULT_VOICE=
# 远端主机模型及参考音频根目录（留空默认 D:\TTS_GPT_SoVITS）
ZERO_TTS_REMOTE_BASE=

# weicoz-video-shotcraft-patch：calibrate-voice.py 定位 weicoz-zero-tts 的 zero_tts.py（可选，留空则在本仓库 skills/weicoz-zero-tts/scripts/ 里找）
ZERO_TTS_SCRIPT=

# weicoz-video-shotcraft-patch：media-source.py 真实素材搜索（缺 Key 的来源会被跳过并提示；Wikimedia Commons 无需 Key）
# Pexels API Key（https://www.pexels.com/api/）
PEXELS_API_KEY=
# Pixabay API Key（https://pixabay.com/api/docs/）
PIXABAY_API_KEY=
# Unsplash Access Key（https://unsplash.com/developers）
UNSPLASH_ACCESS_KEY=
# Wikimedia 要求的 User-Agent；留空默认 weicoz-video-shotcraft-patch/1.0 (media-source)
MEDIA_SOURCE_UA=
